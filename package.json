  "name": "sb-admin-pro-angular",
  "prettier": {
    "singleQuote": true
  },
  "private": true,
  "scripts": {
    "build": "npm run ng build -prod --statsJson=true --outputHashing=all && npm run build:version && npm run dist:copy",
    "build:debug": "npm run build:pug && npm run ng -- build --prod --source-map --build-optimizer=true --statsJson=true && npm run build:version",
    "build:local": "ng build -c=local",
    "build:prod": "npm run build:pug && npm run ng -- build --prod --build-optimizer=true --outputHashing=all --statsJson=true && npm run build:version",
    "build:propCatalyst": "ng build -c=propCatalyst",
    "build:propShare": "ng build -c=propShare",
    "build:pug": "node scripts/build-pug.js",
    "build:sandbox": "npm run build:pug && ng build -c=sandbox && npm run build:version",
    "build:strata": "ng build -c=strata",
    "build:version": "node scripts/version.js",
    "bundle-report": "webpack-bundle-analyzer dist/sb-admin-pro-angular/stats-es2015.json",
    "cy": "cypress open",
    "cy:report": "node scripts/cy-report.js",
    "cy:serve": "static-server ./cypress/reports/html 7200",
    "dist:copy": "node scripts/copyDist.js",
    "docker:build": "node scripts/docker/docker-build.js",
    "docker:run": "node scripts/docker/docker-run.js",
    "e2e": "npm run ng -- e2e --port 6200 --suite",
    "generate:component": "ng generate @sbpro/ng:component",
    "generate:directive": "ng generate @sbpro/ng:directive",
    "generate:module": "ng generate @sbpro/ng:module",
    "generate:service": "ng generate @sbpro/ng:service",
    "lint": "npm run ng -- lint",
    "lint:fix": "npm run ng -- lint --fix",
    "ng": "cross-env NODE_OPTIONS=--max_old_space_size=2048 ./node_modules/.bin/ng",
    "postinstall": "node ./ng-add-pug-loader.js",
    "serve": "static-server dist/sb-admin-pro-angular",
    "serve:coverage": "static-server ./coverage/sb-admin-pro-angular 9753",
    "start": "node scripts/start.js",
    "start:local": "node scripts/start-local.js",
    "start:prod": "node scripts/start-prod.js",
    "start:propCatalyst": "npm run build:pug && ng serve -c=propCatalyst --port=4200",
    "start:propShare": "npm run build:pug && ng serve -c=propShare --port=4200",
    "start:sandbox": "npm run build:pug && ng serve -c=sandbox --port=4200",
    "start:strata": "npm run build:pug && ng serve -c=strata --port=4200",
    "templateUrl:html": "node scripts/update-template-url-ext.js --html",
    "templateUrl:pug": "node scripts/update-template-url-ext.js --pug",
    "test": "mocha --opts test/mocha.opts",
    "test:dev": "node scripts/test-dev.js",
    "version": "node scripts/version"
  },
  "version": "1.1.3"
