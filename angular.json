{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "sb-admin-pro-angular": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "sbpro",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "outputPath": "dist_temp/sb-admin-pro-angular",
            "index": "src/index.html",
            "main": "src/main.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.app.json",
            "aot": false,
            "assets": [
              "src/favicon.png",
              "src/assets",
              "src/.htaccess",
              {
                "glob": "**/*",
                "input": "node_modules/tinymce",
                "output": "/tinymce/"
              }
            ],
            "styles": [
              "src/styles/styles.scss",
              "./node_modules/intl-tel-input/build/css/intlTelInput.css",
              "./node_modules/angular2-multiselect-dropdown/themes/default.theme.css"
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["src", "./node_modules"]
            },
            "scripts": ["node_modules/tinymce/tinymce.min.js"]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractCss": true,
              "namedChunks": false,
              "aot": true,
              "extractLicenses": true,
              "vendorChunk": false,
              "buildOptimizer": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            },
            "sandbox": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.sandbox.ts"
                }
              ]
            },
            "local": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.local.ts"
                }
              ]
            },
            "strata": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.strata.ts"
                }
              ]
            },
            "propShare": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prop-share.ts"
                }
              ]
            },
            "propCatalyst": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prop-catalyst.ts"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "browserTarget": "sb-admin-pro-angular:build"
          },
          "configurations": {
            "production": {
              "browserTarget": "sb-admin-pro-angular:build:production"
            },
            "strata": {
              "browserTarget": "sb-admin-pro-angular:build:strata"
            },
            "sandbox": {
              "browserTarget": "sb-admin-pro-angular:build:sandbox"
            },
            "local": {
              "browserTarget": "sb-admin-pro-angular:build:local"
            },
            "propShare": {
              "browserTarget": "sb-admin-pro-angular:build:propShare"
            },
            "propCatalyst": {
              "browserTarget": "sb-admin-pro-angular:build:propCatalyst"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "sb-admin-pro-angular:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "assets": ["src/favicon.png", "src/assets"],
            "styles": ["src/styles/styles.scss"],
            "stylePreprocessorOptions": {
              "includePaths": ["src", "./node_modules"]
            },
            "scripts": [],
            "codeCoverageExclude": ["src/testing/**/*"]
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "tsconfig.app.json",
              "tsconfig.spec.json",
              "e2e/tsconfig.json"
            ],
            "exclude": ["**/node_modules/**"]
          }
        },
        "e2e": {
          "builder": "@angular-devkit/build-angular:protractor",
          "options": {
            "protractorConfig": "e2e/protractor.conf.js"
          },
          "configurations": {
            "production": {
              "devServerTarget": "sb-admin-pro-angular:serve:production"
            }
          }
        }
      }
    }
  },
  "defaultProject": "sb-admin-pro-angular",
  "cli": {
    "analytics": "706b227e-596c-4d4d-a117-95c41beec97d"
  }
}
