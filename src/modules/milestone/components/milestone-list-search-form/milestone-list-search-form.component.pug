form
  .form-group.form-inline.row.align-items-stretch
    .mt-1.col-xl-3.col-lg-5.col-md-8.col-sm-12
      .form-check-label
      input#search-box.mt-2.form-control.form-control-sm.w-100(
        type='text',
        name='s',
        placeholder='Search',
        [(ngModel)]='searchText'
      )
    .mt-1.col-xl-1.col-lg-3.col-md-4.col-sm-12.d-flex.flex-row.align-items-end
      button.btn.btn-primary.btn-sm.mt-2.mr-2(
        type='submit',
        (click)='performSearch()'
      ) Submit
      button.btn.btn-link.btn-sm.mt-2.mr-2(type='button', (click)='clearForm()')
        | Clear
