  div
    h4 Team Members
    .table-responsive.pp-table-container.table-responsive-sm
      table.table
        thead
          tr
            th
              span.ws-nowrap S.No.
            th
              span.ws-nowrap Member Name

            th
              span Mobile number

            th
              span.ws-nowrap Email ID

            th
              span.ws-nowrap Role

            th
              span.ws-nowrap(*ngIf='!disableInvite') Action

        tbody(*ngIf='members.length === 0')
          tr
            td No Entries Found
        tbody(*ngIf='members.length > 0')
          tr(
            *ngFor='let member of members; let i = index',
            (mouseover)='selectedToolTipData = member'
          )
            td
              span {{ i + 1 }}
            td
              span(*ngIf='member.user.firstName') {{ member.user.firstName + " " + member.user.lastName }}
              span(*ngIf='!member.user.firstName') --
            td
              span(*ngIf='member.user.mobile') {{ member.user.mobile }}
              span(*ngIf='!member.user.mobile') --
            td
              span(*ngIf='member.email') {{ member.email }}
              span(*ngIf='!member.email') --
            td
              span.tableClickEntryColor(
                *ngIf='member.role',
                style='cursor: pointer; white-space: pre-line',
                [ngbPopover]='ToolTip',
                triggers='mouseenter:mouseleave'
              ) {{ member.role }}
              span(*ngIf='!member.role') --
            td
              button.btn.mr-2.btn-sm.castlerButtonColor(
                type='button',
                (click)='openUpdateModalOnRoleClick(UpdateMember, member.email, member.role, member.user.mobile, member.user.firstName, member.user.lastName)',
                *ngIf='!member.role.includes("owner") && !readOnly && (!merchantProfile.connectedBanking || !merchantProfile.isAccountAddAllowed) && !disableInvite'
              ) Update &nbsp;
                i-feather(name='edit-3')
              button.btn.mr-2.btn-sm.castlerButtonColor(
                type='button',
                (click)='openUpdateModalOnRoleClick(UpdateMemberCbWithVa, member.email, member.role, member.user.mobile, member.user.firstName, member.user.lastName)',
                *ngIf='!member.role.includes("owner") && !readOnly && (merchantProfile.connectedBanking && merchantProfile.isAccountAddAllowed) && !disableInvite'
              ) Update &nbsp;
                i-feather(name='edit-3')
              button.btn.btn-red.mr-2.btn-transparent-dark.btn-sm(
                type='button',
                (click)='openMemberAlertModal(alertModalMember, member.email)',
                *ngIf='!member.role.includes("owner") && !readOnly && !disableInvite'
              ) Delete &nbsp;
                i-feather(name='trash-2')

