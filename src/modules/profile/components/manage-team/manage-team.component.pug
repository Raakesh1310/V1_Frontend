ng-template(#inviteModal)
  .modal-header
    h4.col-12.modal-title.text-center Invite New Member
  .modal-body
    div(*ngIf='inviteProcessingErrors.length > 0')
      sbpro-alert(classes='alert-danger', [dismissable]='true')
        | {{ inviteProcessingErrors[0] }}
    //.text-warning(
    //  *ngIf='inviteProcessingErrors && inviteProcessingErrors.length > 0'
    //)
    //  sbpro-alert([icon]='true', classes='alert-danger sb-alert-solid', [dismissable]='true')
    //    ul
    //      li(*ngFor='let error of inviteProcessingErrors') {{ error }}

    .form-group
      label.small.mb-1(for='inputEmailAddress') First Name
      span.text-danger *
      input#inputFName.form-control.py-1(
        autocomplete='off',
        type='text',
        [(ngModel)]='selectedFName',
        placeholder='Enter First Name'
      )
    .form-group
      label.small.mb-1(for='inputEmailAddress') Last Name
      span.text-danger *
      input#inputLName.form-control.py-1(
        autocomplete='off',
        type='text',
        [(ngModel)]='selectedLName',
        placeholder='Enter Last Name'
      )
    .form-group
      label.small.mb-1(for='inputEmailAddress') Email
      span.text-danger *
      input#inputEmailAddress.form-control.py-1(
        autocomplete='off',
        type='email',
        [(ngModel)]='selectedEmail',
        placeholder='Enter email address'
      )
    .form-group
      label.small.mb-1(for='inputEmailAddress') Phone
      span.text-danger *
      input#inputPhone.form-control.py-1(
        autocomplete='off',
        type='number',
        [(ngModel)]='selectedPhone',
        placeholder='Enter Phone Number'
      )
    .form-group
      label.small.mb-1(for='role') Role
      span.text-danger *
      select#role.form-control([(ngModel)]='selectedRole')
        option(value='') Select Role
        option(*ngFor='let r of roles', [ngValue]='r') {{ r }}
    .form-group(*ngIf='selectedRole === "Custom"  && (!merchantProfile?.connectedBanking && merchantProfile?.isAccountAddAllowed)')
      label.small.mb-1(for='accounts') Escrows
      span.text-danger *
      angular2-multiselect#accounts(
        [data]='dropdownListEscrows',
        [(ngModel)]='selectedItems',
        [settings]='dropdownSettingsEscrows',
        (onSelect)='onItemSelect($event)',
        (onDeSelect)='OnItemDeSelect($event)',
        (onSelectAll)='onSelectAll($event)',
        (onDeSelectAll)='onDeSelectAll($event)'
      )
    .form-group(*ngIf='selectedRole === "Custom"  && (merchantProfile?.connectedBanking && !merchantProfile?.isAccountAddAllowed)')
      label.small.mb-1(for='accounts') Bank Accounts
      span.text-danger *
      angular2-multiselect#bankAccounts(
        [data]='dropdownListBankAccounts',
        [(ngModel)]='selectedBankAccounts',
        [settings]='dropdownSettingsBankAccounts',
        (onSelect)='onItemSelect($event)',
        (onDeSelect)='OnItemDeSelect($event)',
        (onSelectAll)='onSelectAll($event)',
        (onDeSelectAll)='onDeSelectAll($event)'
      )
    .form-group(*ngIf='selectedRole === "Custom"')
      label.small.mb-1(for='roleName') Role Name
      span.text-danger *
      input#roleName.form-control.py-1(
        autocomplete='off',
        type='text',
        [(ngModel)]='roleName',
        placeholder='Enter Role Name'
      )
    .form-group
      sbpro-alert(
        classes='alert-primary text-center',
        *ngIf='selectedRole === "Admin"'
      )
        | Has access to all features excluding Manage Team
      sbpro-alert(
        classes='alert-primary text-center',
        *ngIf='selectedRole === "Finance"'
      )
        | Has access to payments-related data like transaction report and passbook
      sbpro-alert(
        classes='alert-primary text-center',
        *ngIf='selectedRole === "Payee"'
      )
        | Has Access to all escrows in which Payee is linked
      sbpro-alert(
        classes='alert-primary text-center',
        *ngIf='selectedRole === "Custom"'
      )
        h3 Select Features
        small
          | Access to selected features will be given
    .form-group(*ngIf='selectedRole === "Custom"  && (!merchantProfile?.connectedBanking && merchantProfile?.isAccountAddAllowed)', (change)= 'checkValues()')
      .form-check.pl-5
        input#selectAll.form-check-input(
          type='checkbox',
          [(ngModel)]='selectAllItemsCheckBox',
          (change)='selectAllItems($event)'
        )
        label.form-check-label(for='selectAll')
          | Select All
      .form-check.pl-5
        input#accountList.form-check-input(
          type='checkbox',
          [(ngModel)]='features.createAccount',
          (change)='checkBoxVal($event,"createAccount")',
          [disabled]='disableAddEscrow',
        )
        label.form-check-label(for='createAccount')
          | Create Escrow
      .form-check.pl-5
        input#accountList.form-check-input(
          type='checkbox',
          [(ngModel)]='features.accountList',
          (change)='checkBoxVal($event,"accountList")',
        )
        label.form-check-label(for='accountList')
          | Escrow List 
      .form-check.pl-5
        input#addPayee.form-check-input(
          type='checkbox',
          [(ngModel)]='features.addPayee',
          (change)='checkBoxVal($event,"addPayee")'
        )
        label.form-check-label(for='addPayee')
          | Add Payee
      .form-check.pl-5
        input#payeeList.form-check-input(
          type='checkbox',
          [(ngModel)]='features.payeeList',
          (change) = 'checkBoxVal($event, "payeeList")'
        )
        label.form-check-label(for='payeeList')
          | Payee List
      .form-check.pl-5
        input#singleTransfer.form-check-input(
          type='checkbox',
          [(ngModel)]='features.singleTransfer',
          (change)='checkBoxVal($event,"singleTransfer")'
        )
        label.form-check-label(for='singleTransfer')
          | Single Transfer
      .form-check.pl-5
        input#bulkTransfer.form-check-input(
          type='checkbox',
          [(ngModel)]='features.bulkTransfer',
          (change)='checkBoxVal($event,"bulkTransfer")'
        )
        label.form-check-label(for='bulkTransfer')
          | Bulk Transfer      
      .form-check.pl-5
        input#myPassbook.form-check-input(
          type='checkbox',
          [(ngModel)]='features.myPassbook',
          (change)='checkBoxVal($event, "myPassbook")'
        )
        label.form-check-label(for='myPassbook')
          | My Passbook
    .form-group(*ngIf='selectedRole === "Custom"  && (merchantProfile?.connectedBanking && !merchantProfile?.isAccountAddAllowed)', (change)='checkValues()')
      .form-check.pl-5
        input#selectAll.form-check-input(
          type='checkbox',
          [(ngModel)]='selectAllConnectedBanking',
          (change)='selectAllItemsConnectedBanking($event)'
        )
        label.form-check-label(for='selectAll')
          | Select All
      .form-check.pl-5
        input#bankAccounts.form-check-input(
          type='checkbox',
          [(ngModel)]='featuresConnectedBanking.bankAccounts'
        )
        label.form-check-label(for='bankAccounts')
          | Bank Accounts
      .form-check.pl-5
        input#addPayee.form-check-input(
          type='checkbox',
          [(ngModel)]='featuresConnectedBanking.addPayee',
          (change)='checkBoxVal($event,"cbAddPayee")'
        )
        label.form-check-label(for='addPayee')
          | Add Payee
      .form-check.pl-5
        input#payeeList.form-check-input(
          type='checkbox',
          [(ngModel)]='featuresConnectedBanking.payeeList',
          (change) = 'checkBoxVal($event, "cbPayeeList")'
        )
        label.form-check-label(for='payeeList')
          | Payee List
      .form-check.pl-5
        input#singleTransfer.form-check-input(
          type='checkbox',
          [(ngModel)]='featuresConnectedBanking.singleTransfer',
          (change)='checkBoxVal($event, "cbSingleTransfer")'
        )
        label.form-check-label(for='singleTransfer')
          | Single Transfer
      .form-check.pl-5
        input#bulkTransfer.form-check-input(
          type='checkbox',
          [(ngModel)]='featuresConnectedBanking.bulkTransfer',
          (change)='checkBoxVal($event, "cbBulkTransfer")'
        )
        label.form-check-label(for='bulkTransfer')
          | Bulk Transfer
      .form-check.pl-5
        input#bankAccountTransfer.form-check-input(
          type='checkbox',
          [(ngModel)]='featuresConnectedBanking.bankAccountTransfer',
          (change) = 'checkBoxVal($event,"bankAccountTransfer")'
        )
        label.form-check-label(for='bankAccountTransfer')
          | Transfers List 
      .form-check.pl-5
        input#depositList.form-check-input(
          type='checkbox',
          [(ngModel)]='featuresConnectedBanking.depositList'
        )
        label.form-check-label(for='depositList')
          | Deposit List
  .modal-footer
    button.btn.btn-light(type='button', (click)='closeModal()') Cancel
    sbpro-app-button((click)='sendInvite()', text='Invite', [loading]='')

