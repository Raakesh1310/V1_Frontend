    h4 Update Member
  .modal-body
    div(*ngIf='inviteProcessingErrors.length > 0')
      sbpro-alert(classes='alert-danger', [dismissable]='true')
        | {{ inviteProcessingErrors[0] }} 
  .modal-body
    .alert.alert-danger.alert-dismissible.fade.show(
      role='alert',
      *ngIf='errors.length > 0'
    )
      | {{ errors[0] }}
      button.close(
        type='button',
        (click)='errors = []',
        data-dismiss='alert',
        aria-label='Close'
      )
        span(aria-hidden='true') ×
    .row
      .col.mr-2
        .detailsText First Name
        div {{ selectedFName || "--" }}
      .col
        .detailsText Last Name
        div {{ selectedLName || "--" }}
      .w-100.mb-3
      .col.mr-2
        .detailsText Email Id
        div {{ selectedEmail || "--" }}
      .col
        .detailsText Mobile
        div {{ selectedPhone || "--" }}

    .row
      .col-4.mt-3.flex-display
        label.mt-2(for='role') Role
        span.text-danger.mr-3.mt-2 *
      .col-8.mt-3
        select#role.form-control([(ngModel)]='selectedRole')
          option(value='') Select Role
          option(*ngFor='let role of filteredRoles', [ngValue]='role') {{ role }}
    .row(*ngIf='selectedRole === "Custom" && (!merchantProfile?.connectedBanking && merchantProfile?.isAccountAddAllowed)')
      .col-4.mt-3.flex-display
        label.mt-2(for='accounts') Escrows
        span.text-danger.mr-3.mt-2 *
      .col-8.mt-3
        angular2-multiselect#accounts(
          [data]='dropdownListEscrows',
          [(ngModel)]='selectedItems',
          [settings]='dropdownSettingsEscrows',
          (onSelect)='onItemSelect($event)',
          (onDeSelect)='OnItemDeSelect($event)',
          (onSelectAll)='onSelectAll($event)',
          (onDeSelectAll)='onDeSelectAll($event)'
        )
  
    .row(*ngIf='selectedRole === "Custom" && (merchantProfile?.connectedBanking && !merchantProfile?.isAccountAddAllowed)')
      .col-4.mt-3.flex-display
        label.mt-2(for='accounts') Bank Accounts
        span.text-danger.mr-3.mt-2 *
      .col-8.mt-3
        angular2-multiselect#bankAccounts(
          [data]='dropdownListBankAccounts',
          [(ngModel)]='selectedBankAccounts',
          [settings]='dropdownSettingsBankAccounts',
          (onSelect)='onItemSelect($event)',
          (onDeSelect)='OnItemDeSelect($event)',
          (onSelectAll)='onSelectAll($event)',
          (onDeSelectAll)='onDeSelectAll($event)'
        )

    .row(*ngIf='selectedRole === "Custom"')
      .col-4.mt-3.flex-display
        label.mt-2(for='role') Role Name
        span.text-danger.mr-3.mt-2 *
      .col-8.mt-3
        input#roleName.form-control.py-1(
