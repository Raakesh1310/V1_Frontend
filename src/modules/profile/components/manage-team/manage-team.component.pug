ng-template(#resendModal)
  .modal-header
    h4 Resend Invite
  .modal-body
    div(*ngIf='inviteProcessingErrors.length > 0')
      sbpro-alert(classes='alert-danger', [dismissable]='true')
        | {{ inviteProcessingErrors[0] }}
  .modal-body
    .form-group
      label.small.mb-1(for='inputEmailAddress') Email
      span#inputEmailAddress.form-control {{ selectedEmail }}
    .form-group
      label.small.mb-1(for='role') Role
      span#role.form-control {{ selectedRole }}
    .form-group
      sbpro-alert(classes='alert-primary', *ngIf='selectedRole === "Admin"')
        | Has access to all features excluding Manage Team
      sbpro-alert(classes='alert-primary', *ngIf='selectedRole === "Manager"')
        | Has access to the creation of Escrow and Add payees
      sbpro-alert(classes='alert-primary', *ngIf='selectedRole === "Finance"')
        | Has access to payments-related data like transaction report and passbook
  .modal-footer
    button.btn.castlerButtonColor((click)='resendInvite()') Resend
    button.btn.btn-link((click)='closeModal()') cancel

ng-template(#alertModalMember)
  .modal-header
    h4 Are you sure!
  .modal-body
    sbpro-alert(classes='alert-warning')
      | Do you want to remove "{{ selectedEmail }}" as a member of your team.
  .modal-footer
    button.btn.castlerButtonColor((click)='deleteMember()') Yes, remove
    button.btn.btn-link.logoColor((click)='closeModal()') No, Don't remove

ng-template(#alertModalInvite)
  .modal-header
    h4 Are you sure!
  .modal-body
    sbpro-alert(classes='alert-warning')
      | Do you want to remove "{{ selectedEmail }}" invite.
  .modal-footer
    button.btn.castlerButtonColor((click)='deleteInvitee()') Yes, remove
    button.btn.btn-link((click)='closeModal()') No, Don't remove

ng-template(#UpdateMember)
