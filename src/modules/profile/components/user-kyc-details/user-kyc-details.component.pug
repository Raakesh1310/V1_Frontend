sbpro-card
  .card
  .card-header Details
  .card-body
    table.table
      tr
        td Business Name
        td {{ profile.businessName }}
      tr
        td Email
        td {{ profile.email }}
      tr
        td GST Number
        td {{ profile.businessGst }}
      tr
        td Company PAN
        td {{ profile.businessPan }}
      tr
        td Authorised person Name
        td {{ profile.authorizedPersonName }}
      tr
        td Authorised person PAN
        td {{ profile.authorizedPersonPan }}
    .row
      .col
        h4.display-6 Documents

    .sb-preview
      .sbp-preview-content
        form
          .form-group
            div(*ngIf='errors.length > 0')
              sbpro-alert(classes='alert-danger', [dismissable]='true')
                | {{ errors[0] }}

          .form-group(*ngIf='gstFile')
            label Company GST
            br
            .row
              .col.col-md-10
                #dummy.form-control
                  p
                    a(href='{{ downloadGst() }}', target='_blank') {{ gstFile }}
                    span.linker((click)='removeGst()') &nbsp;&nbsp;&nbsp;&nbsp;
                      img(
                        src='data:image/png;base64,'
                      )
              .col.col-md-2
                .custom-control.custom-checkbox
                  input#docBusinessGst.custom-control-input(
                    type='checkbox',
                    (change)='verifyDoc($event)',
                    name='docBusinessGstVerified',
                    [(ngModel)]='profile.docBusinessGstVerified'
                  )
                  label.custom-control-label(for='docBusinessGst') Verified
          .form-group(*ngIf='!gstFile')
            label(for='gstupload') Company GST
              span.text-danger 
                | *
            .custom-file.mb-lg-3
              input#docBusinessGst.form-control.custom-file-input(
                type='file',
                (change)='handleFileInput($event)',
                enctype='multipart/form-data',
                [disabled]='docBusinessGst'
              )
              label.custom-file-label(for='gstupload') Upload File (Max size 5 MB)

