sbpro-card([headerActions]='true')
  .card-header
    | Hard Escrow Details
    button.btn.btn-icon.btn-link.btn-xl((click)='closeModal()')
      i-feather(name='x-circle')
  .card-body
    div(*ngIf='errors && errors.length > 0')
      sbpro-alert(classes='alert-danger')
        | {{ errors[0] }}
    form([formGroup]='hardEscrowForm')
      .d-flex
        .form-group.w-100.mr-2
          label(for='frm-cntrl-accountNo') Account No
          span.text-danger *
          input#frm-cntrl-accountNo.form-control.form-control-sm(
            type='string',
            [readonly]="isEdit",
            formControlName='accountNo',
            placeholder='Account No'
          )
        .form-group.w-100
          label(for='frm-cntrl-accountName') Account Name
          span.text-danger *
          input#frm-cntrl-accountName.form-control.form-control-sm(
            type='string',
            formControlName='accountName',
            placeholder='Account Name'
          )
      .d-flex
        .form-group.w-100.mr-2
          label(for='frm-cntrl-ifsc') IFSC
          span.text-danger *
          input#frm-cntrl-ifsc.form-control.form-control-sm(
            type='string',
            formControlName='ifsc',
            placeholder='IFSC',
          )
        .form-group.w-100.mr-2
          label(for='frm-cntrl-clientCode') Client Code
          span.text-danger *
          input#frm-cntrl-clientCode.form-control.form-control-sm(
            type='string',
            formControlName='clientCode',
            placeholder='Client Code',
          )
      //- .d-flex
      //-   .form-group.w-100.mr-2
      //-     label(for='frm-cntrl-clientId') Client Id
      //-     input#frm-cntrl-clientId.form-control.form-control-sm(
      //-       type='string',
      //-       formControlName='clientId',
      //-       placeholder='Client ID',
      //-     )
      //-   .form-group.w-100.mr-2
      //-     label(for='frm-cntrl-clientSecret') Client Secret
      //-     input#frm-cntrl-ClientSecret.form-control.form-control-sm(
      //-       type='password',
      //-       formControlName='clientSecret',
      //-       placeholder='Client Secret',
      //-       autocomplete='new-password'
      //-     )
      .d-flex
        .form-group.w-100.mr-2
          label(for='frm-cntrl-sftpUpload') SFTP Upload Path
          span.text-danger *
          input#frm-cntrl-sftpUpload.form-control.form-control-sm(
            type='string',
            formControlName='sftpUploadPath',
            placeholder='SFTP Upload Path',
          )
        .form-group.w-100.mr-2
          label(for='frm-cntrl-sftpReport') SFTP Report Path
          span.text-danger *
          input#frm-cntrl-sftpReport.form-control.form-control-sm(
            type='string',
            formControlName='sftpReportPath',
            placeholder='SFTP Report Path',
          )
      .d-flex
        .form-group.w-100.mr-2
          label(for='frm-cntrl-accountPrefix') Account Prefix
          span.text-danger *
          input#frm-cntrl-accountPrefix.form-control.form-control-sm(
            type='string',
            formControlName='accountPrefix',
            placeholder='Account Prefix',
          )
        .form-group.w-100.mr-2
          label(for='frm-cntrl-uploadFilename') Upload File Name
          span.text-danger *
          input#frm-cntrl-uploadFilename.form-control.form-control-sm(
            type='string',
            formControlName='uploadFilename',
            placeholder='Upload File Name',
          )
      .d-flex
        .form-group.w-100.mr-2
          label(for='frm-cntrl-aggregatorName') Aggregator Name
          span.text-danger *
          input#frm-cntrl-aggregatorName.form-control.form-control-sm(
            type='string',
            formControlName='aggregatorName',
            placeholder='Aggregator Name',
          )
        .form-group.w-100.mr-2
          label(for='frm-cntrl-aggregatorId') Aggregator Id
          span.text-danger *
          input#frm-cntrl-aggregatorId.form-control.form-control-sm(
            type='string',
            formControlName='aggregatorId',
            placeholder='Aggregator Id',
          )
      .d-flex
        .form-group.w-100.mr-2
          label(for='frm-cntrl-userId') User Id
          span.text-danger *
          input#frm-cntrl-userId.form-control.form-control-sm(
            type='string',
            formControlName='userId',
            placeholder='User Id',
          )
        .form-group.w-100.mr-2
          label(for='frm-cntrl-corpId') Corp Id
          span.text-danger *
          input#frm-cntrl-corpId.form-control.form-control-sm(
            type='string',
            formControlName='corpId',
            placeholder='Corp Id',
          )
      .d-flex
        .form-group.w-100.mr-2
          label(for='frm-cntrl-trusteeMail') Trustee Email
          input#frm-cntrl-trusteeMail.form-control.form-control-sm(
            type='string',
            formControlName='trusteeMail',
            placeholder='Trustee Email',
          )
      .d-flex
        .form-group.w-50.mr-2
          .row
            .col-sm-12.col-md-9.col-lg-9
              label(for='frm-cntrl-cb') Enable Connected Banking
            .col-sm-12.col-md-3.col-lg-3
              input#frm-cntrl-cb.form-control.form-control-sm.float-left(
                type='checkbox',
                #checkbox,
                name='enableConnectedBanking',
                formControlName='enableConnectedBanking',
                [disabled]='hide'
              )
      .d-flex 
        .form-group.w-100.mr-2(*ngIf="hardEscrowForm.get('enableConnectedBanking').value")
          .row
            .col-sm-4
              label(for='frm-cntrl-cb') With Digital Escrow
              input.ml-2(
                type='radio',
                name='enableConnectedBankingWithVA',
                formControlName='enableConnectedBankingWithVA',
                [value]="true",
                (change)="updateEnableConnectedBanking(true)"
              )
            .col-sm-4
              label(for='frm-cntrl-cb') Without Digital Escrow
              input.ml-2(
                type='radio',
                name='enableConnectedBankingWithVA',
                formControlName='enableConnectedBankingWithVA',
                [value]="false",
                (change)="updateEnableConnectedBanking(false)"
              )
      .d-flex(*ngIf="hardEscrowForm.get('enableConnectedBanking').value")
        .form-group.w-100.mr-2
          label(for='frm-cntrl-accountType') Account Type
          select#frm-cntrl-accountType.form-control.form-control-sm(
            formControlName='accountType',
            [value] = 'accountType',
          )
            option(value='Escrow Account') Escrow Account
            option(value='Current Account') Current Account
    sbpro-app-button.float-right(
      *ngIf='!isEdit',
      (click)='onSubmit()',
      [loading]='submitting',
      text='Submit',
      loadingText='Submitting'
    )
    sbpro-app-button.float-right(
      *ngIf='isEdit',
      (click)='onSubmit()',
      [loading]='submitting',
      text='Update',
      loadingText='Submitting'
    )