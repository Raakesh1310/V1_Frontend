div
  div
    .sb-preview
      .sbp-preview-content
        div(*ngIf='!apiCredentialPresent')
          p No Api Key Found
          br
          button.btn(type='submit', (click)='generateCredentials()', class='castlerButtonColor') Create new
        div(*ngIf='apiCredentialPresent')
          p Api Key: {{ apiKey }}
          p Api Secret: {{ apiSecret }}
          br
          p Note: Please note that if any action perform by clicking any of the below button will remove access for current api Credentials
          br
          button.btn(type='submit', (click)='deleteCredentials()', class='castlerButtonColor') Delete
          | &nbsp;&nbsp;
          button.btn(type='submit', (click)='generateCredentials()', class='castlerButtonColor') Delete and Generate New
