div(*ngIf='!(loadingData$ | async) && dataLoaded')
  .form-group
    div(*ngIf='errors.length > 0')
      sbpro-alert(classes='alert-danger', [dismissable]='true')
        | {{ errors[0] }}
    div(*ngIf='success.length > 0')
      sbpro-alert([icon]='true' classes='alert-success sb-alert-solid')
        p {{ success[0] }}
  form(autocomplete='off', [formGroup]='bankForm')
    .block
      h4 Bank Details
      br
    .form-group
      .col-sm-12.col-md-12.col-lg-12(style='overflow:auto')
        label.font-weight-bold.text-black(*ngIf='!readOnly')
          | Select One or Multiple Banks
        br
        br
        .row
          .card.border.rounded.float-left.shadow-lg.mb-5.bg-white.rounded.bank-card
            .card-header(style='display:block')
              .row
                .col-sm-12.col-md-6.col-lg-6
                  label(for='rblCheckbox') 
                    | RBL
                .col-sm-12.col-md-6.col-lg-6
                  input(
                    type='checkbox',
                    #checkbox,
                    name='rblCheckbox',
                    formControlName='rblCheckbox',
                    (change)='updateCheckBoxVal("rblCheckbox", $event)',
                    [disabled]='readOnly ? false : null',
                    style='float:right'
                  )
            .row(*ngIf='bankForm.controls.rblCheckbox.value' style='padding:10%')
              .col-sm-12.col-md-6.col-lg-6
                .row
                  input(
                    type='radio',
                    name='rblAccountTypeSelect',
                    [checked]='rblAccountType == "global"',
                    (click)='changeRBLAccountType("global")'
                  )
                  label(for='rblAccountTypeSelect')
                    | &nbsp;&nbsp; NCOME Escrow
                .row
                  input(
                    type='radio',
                    name='rblAccountTypeSelect',
                    [checked]='rblAccountType == "custom"',
                    (click)='changeRBLAccountType("custom")'
                  )
                  label(for='rblAccountTypeSelect')
                    | &nbsp;&nbsp; Merchant Escrow
                  .col-sm-12.col-md-6.col-lg-6
              br
              .col-sm-12.col-md-6.col-lg-6
                .row(*ngIf='bankForm.controls.rblCheckbox.value && rblAccountType == "custom"')
                  button.btn.ws-wrap.castlerButtonColor(
                    type='button',
                    (click)='createAccount("rbl")',
                    style='margin:auto'
                  )
                    span + Add Account
                  br
                  br
                  br
              .card.w-100.p-3.mt-2(*ngIf='bankForm.controls.rblCheckbox.value')
                .h4 Select Account
                br
                div.bank-list
                  div(
                    formArrayName='rblBanksFA',
                    *ngFor='let order of rblBanksFormArray.controls; let i = index'
                  )
                    .row
                      .col-sm-12.col-md-12.col-lg-12
                        .badge.badge-light
                          .ml-2.hard-escrow-list(*ngIf='rblAccountType == "custom"' style='float:left')
                            a(
                              [routerLink]='',
                              (click)='editAccount(rblBanks[i], "rbl")' 
                            ) {{ i + 1 }}.{{ rblBanks[i].rblAccountNo }} &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                          .ml-2.hard-escrow-list(
                            *ngIf='rblAccountType == "global"',
                            style='float:left'
                          )
                            a {{ i + 1 }}.{{ rblBanks[i].rblAccountNo }} &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                          input(
                            type='checkbox',
                            (change)='updateCheckBoxRBlBanks(i, $event)',
                            [checked]='order.value.accountChecked',
                            style='float:right;'
                          )
                      br
                    .div(*ngIf='order.value.accountChecked && order.value.payoutMode === "api"')
                      .row
                        .col-sm-12.col-md-12.col-lg-12
                          label
                            | Trustee Access
                      .row
                        .col-sm-12.col-md-4.col-lg-4
                          input(
                            type='radio',
                            name='rblTrusteeAccessCheckBox{{i}}',
                            [checked]='order.value.trusteeAccess == "view"',
                            (click)='updateTrusteeAccess(i, "view", "rbl")' 
                          ) 
                          br
                          label.hard-escrow-settings
                            | View
                        .col-sm-12.col-md-4.col-lg-4
                          input(
                            type='radio',
                            name='rblTrusteeAccessCheckBox{{i}}',
                            [checked]='order.value.trusteeAccess == "approve"',
                            (click)='updateTrusteeAccess(i, "approve", "rbl")' 
                          ) 
                          br
                          label.hard-escrow-settings
                            | Approve
                        .col-sm-12.col-md-4.col-lg-4
                          input(
                            type='radio',
                            name='rblTrusteeAccessCheckBox{{i}}',
                            [checked]='order.value.trusteeAccess == "none"',
                            (click)='updateTrusteeAccess(i, "none", "rbl")' 
                          )
                          br
                          label.hard-escrow-settings
                            | No Rights
                      br
                    .row(
                      *ngIf='order.value.trusteeAccess == "approve" && order.value.accountChecked && order.value.payoutMode === "api"'
                    )
                      .col-sm-12.col-md-12.col-lg-12
                        label
                          | Approval Threshold
                    .row(
                      *ngIf='order.value.trusteeAccess == "approve" && order.value.accountChecked && order.value.payoutMode === "api"'
                    )
                      .col
                        input(
                          type='number',
                          formControlName='trusteeThresholdAmt',
                          [value]='order.value.trusteeThresholdFreq == "no-limit" ? 0 : order.value.trusteeThresholdAmt',
                          (change)='trusteeThresholdAmt(i, $event, "rbl")',
                          [attr.disabled]='order.value.trusteeThresholdFreq == "no-limit" ? true : null'
                        )
                      .col
                        select#approve-threshold-freq.form-control.form-control-sm(
                          formControlName='trusteeThresholdFreq',
                          style='height:24px',
                          (change)='trusteeThresholdFreq(i, $event, "rbl")' 
                        )
                          option(
                            value='per-day',
                            [selected]='order.value.trusteeThresholdFreq === "per-day"'
                          ) Per Day
                          option(
                            value='per-month',
                            [selected]='order.value.trusteeThresholdFreq === "per-month"'
                          ) Per Month
                          option(
                            value='per-transaction',
                            [selected]='order.value.trusteeThresholdFreq === "per-transaction"'
                          ) Per Transaction
                          option(
                            value='no-limit',
                            [selected]='order.value.trusteeThresholdFreq === "no-limit"'
                          ) No limit
                      br
                      br
                    .row(*ngIf='order.value.accountChecked && order.value.payoutMode === "api"')
                      .col-sm-12.col-md-10.col-lg-10
                        label
                          | Disable Admin Approval
                      .col-sm-12.col-md-2.col-lg-2
                        input(
                          type='checkbox',
                          name='rblAdminDisableCheckBox{{i}}',
                          (click)='adminDisable(i, $event, "rbl")',
                          [checked]='order.value.disableAdmin'
                        )
                      br
                    .row(*ngIf='order.value.accountChecked && order.value.payoutMode === "api"')
                      .col-sm-12.col-md-10.col-lg-10
                        label
                          | Enable IMPS
                      .col-sm-12.col-md-2.col-lg-2
                        input(
                          type='checkbox',
                          name='rblEnableIMPSCheckBox{{i}}',
                          (click)='enableIMPS(i, $event, "rbl")',
                          [checked]='order.value.isIMPS'
                        )
                      br
                    .div(*ngIf='order.value.accountChecked')
                      .row
                        .col-sm-12.col-md-10.col-lg-10
                          label
                            | Payout Mode
                        .row.pl-4
                          .col-sm-6
                            input(
                              type='radio',
                              name='rblPayoutMode{{i}}',
                              [checked]='order.value.payoutMode == "api"',
                              (click)='updatePayoutMode(i, "api", "rbl")' 
                            ) 
                            br
                            label.hard-escrow-settings
                              | API
                          .col-sm-6
                            input(
                              type='radio',
                              name='rblPayoutMode{{i}}',
                              [checked]='order.value.payoutMode == "h2h"',
                              (click)='updatePayoutMode(i, "h2h", "rbl")' 
                            ) 
                            br
                            label.hard-escrow-settings
                              | H2H
                        br
            br
