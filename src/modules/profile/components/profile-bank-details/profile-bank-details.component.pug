                            type='radio',
                            name='dbsPayoutMode{{i}}',
                            [checked]='order.value.payoutMode == "api"',
                            (click)='updatePayoutMode(i, "api", "dbs")' 
                          ) 
                          br
                          label.hard-escrow-settings
                            | API
                        br
          .card.border.rounded.float-left.shadow-lg.mb-5.bg-white.rounded.bank-card
            .card-header(style='display:block')
              .row
                .col-sm-12.col-md-6.col-lg-6
                  label(for='axisCheckbox') 
                    | Axis Bank
                .col-sm-12.col-md-6.col-lg-6
                  input(
                    type='checkbox',
                    #checkbox,
                    name='axisCheckbox',
                    formControlName='axisCheckbox',
                    (change)='updateCheckBoxVal("axisCheckbox", $event)', 
                    [disabled]='readOnly ? false : null',
                    style='float:right'
                  )
            .row(*ngIf='bankForm.controls.axisCheckbox.value' style='padding:10%')
              .col-sm-12.col-md-6.col-lg-6
                .row
                  input(
                    type='radio',
                    name='axisAccountTypeSelect',
                    [checked]='axisAccountType === "global"',
                    (click)='changeAxisAccountType("global")'
                  )
                  label(for='axisAccountTypeSelect')
                    | &nbsp;&nbsp; NCOME Escrow
                .row
                  input(
                    type='radio',
                    name='axisAccountTypeSelect',
                    [checked]='axisAccountType == "custom"',
                    (click)='changeAxisAccountType("custom")'
                  )
                  label(for='axisAccountTypeSelect')
                    | &nbsp;&nbsp; Merchant Escrow
                  .col-sm-12.col-md-6.col-lg-6
              br
              .col-sm-12.col-md-6.col-lg-6
                .row(
                  *ngIf='bankForm.controls.axisCheckbox.value && axisAccountType == "custom"'
                )
                  button.btn.ws-wrap.castlerButtonColor(
                    type='button',
                    (click)='createAccount("axis")',
                    style='margin:auto'
                  )
                    span + Add Account
                  br
                  br
                  br
              .card.w-100.p-3.mt-2(*ngIf='bankForm.controls.axisCheckbox.value')
                .h4 Select Account
                br
                div.bank-list
                  div(
                    formArrayName='axisBanksFA',
                    *ngFor='let order of axisBankFormArray.controls; let i = index'
                  )
                    .row
                      .col-sm-12.col-md-12.col-lg-12
                        .badge.badge-light
                          .ml-2.hard-escrow-list(*ngIf='axisAccountType == "custom"')
                            a(
                              [routerLink]='',
                              (click)='editAccount(axisBanks[i], "axis")' 
                            ) {{ i + 1 }}.{{ axisBanks[i].accountNo }}
                          .ml-2.hard-escrow-list(
                            *ngIf='axisAccountType == "global"'
                          )
                            a {{ i + 1 }}.{{ axisBanks[i].accountNo }}
                          input(
                            type='checkbox',
                            (change)='updateCheckBoxAxisBanks(i, $event)',
                            [checked]='order.value.accountChecked',
                            style='float:right;'
                          )
                      br
                    .div(*ngIf='order.value.accountChecked')
                      .row
                        .col-sm-12.col-md-12.col-lg-12
                          label
                            | Trustee Access
                      .row
                        .col-sm-12.col-md-4.col-lg-4
                          input(
                            type='radio',
                            name='axisTrusteeAccessCheckBox{{i}}',
                            [checked]='order.value.trusteeAccess == "view"',
                            (click)='updateTrusteeAccess(i, "view", "axis")' 
                          ) 
                          br
                          label.hard-escrow-settings
                            | View
                        .col-sm-12.col-md-4.col-lg-4
                          input(
                            type='radio',
                            name='axisTrusteeAccessCheckBox{{i}}',
                            [checked]='order.value.trusteeAccess == "approve"',
                            (click)='updateTrusteeAccess(i, "approve", "axis")' 
                          ) 
                          br
                          label.hard-escrow-settings
                            | Approve
                        .col-sm-12.col-md-4.col-lg-4
                          input(
                            type='radio',
                            name='axisTrusteeAccessCheckBox{{i}}',
                            [checked]='order.value.trusteeAccess == "none"',
                            (click)='updateTrusteeAccess(i, "none", "axis")' 
                          )
                          br
                          label.hard-escrow-settings
                            | No Rights
                      br
                    .row(
                      *ngIf='order.value.trusteeAccess == "approve" && order.value.accountChecked'
                    )
                      .col-sm-12.col-md-12.col-lg-12
                        label
                          | Approval Threshold
                    .row(
                      *ngIf='order.value.trusteeAccess == "approve" && order.value.accountChecked'
                    )
                      .col
                        input(
                          type='number',
                          formControlName='trusteeThresholdAmt',
                          [value]='order.value.trusteeThresholdFreq == "no-limit" ? 0 : order.value.trusteeThresholdAmt',
                          (change)='trusteeThresholdAmt(i, $event, "axis")', 
                          [attr.disabled]='order.value.trusteeThresholdFreq == "no-limit" ? true : null'
                        )
                      .col
                        select#approve-threshold-freq.form-control.form-control-sm(
                          formControlName='trusteeThresholdFreq',
                          style='height:24px',
                          (change)='trusteeThresholdFreq(i, $event, "axis")' 
                        )
                          option(
                            value='per-day',
                            [selected]='order.value.trusteeThresholdFreq == "per-day"'
                          ) Per Day
                          option(
                            value='per-month',
                            [selected]='order.value.trusteeThresholdFreq == "per-month"'
                          ) Per Month
                          option(
                            value='per-transaction',
                            [selected]='order.value.trusteeThresholdFreq === "per-transaction"'
                          ) Per Transaction
                          option(
                            value='no-limit',
                            [selected]='order.value.trusteeThresholdFreq == "no-limit"'
                          ) No limit
                      br
                      br
                    .row(*ngIf='order.value.accountChecked')
                      .col-sm-12.col-md-10.col-lg-10
                        label
                          | Disable Admin Approval
                      .col-sm-12.col-md-2.col-lg-2
                        input(
                          type='checkbox',
                          name='axisAdminDisableCheckBox{{i}}',
                          (click)='adminDisable(i, $event, "axis")', 
                          [checked]='order.value.disableAdmin'
                        )
                      br
                    .row(*ngIf='order.value.accountChecked')
                      .col-sm-12.col-md-10.col-lg-10
                        label
                          | Enable IMPS
                      .col-sm-12.col-md-2.col-lg-2
                        input(
                          type='checkbox',
                          name='axisEnableIMPSCheckBox{{i}}',
                          (click)='enableIMPS(i, $event, "axis")', 
                          [checked]='order.value.isIMPS'
                        )
                      br

        
  .form-group(*ngIf='!readOnly')
    button.btn.castlerButtonColor((click)='onSubmit()', *ngIf='merchantId') Update
    span &nbsp;&nbsp;
  br
.flex-container.flex-row(*ngIf='loadingData$ | async')
