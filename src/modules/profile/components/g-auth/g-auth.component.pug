        .col
          center 
            span(style='font-weight:bold;font-size: 24') Mobile OTP
            div(*ngIf='!isLoginOTPEnabled', style='margin-top: 32px;margin-bottom: 25px;')
              .row
                | Add an extra layer of security to your account by using a one-time mobile OTP in addition to your password each time you log in.
              div(*ngIf='!enableLoginOTP')
                br
                button.btn(type='submit', (click)='enableSendOTP()', class='castlerButtonColor') Enable Mobile OTP
              div(*ngIf='enableLoginOTP')
                div 
                  form([formGroup]='otpForm')
                    .form-group
                      br
                      label.small.mb-1(for='inputOTP') Enter OTP sent on your registered mobile number
                      input#inputOTP.form-control.py-4(
                        data-cy='otp',
                        type='text',
                        placeholder='Enter OTP',
                        formControlName='otp',
                        [class.is-valid]='otpControlValid',
                        [class.is-invalid]='otpControlInvalid',
                        maxLength=6
                      )
                      .invalid-feedback(*ngIf='otpControl.hasError?.required')
                        | OTP is required.
                      .invalid-feedback(*ngIf='otpControl.hasError("minlength")')
                        | Enter the 6 digit OTP.
                      .invalid-feedback(*ngIf='otpControl.hasError("maxlength")')
                        | Enter the 6 digit OTP.
                      br
                      button.btn(
                        type='submit',
                        (click)='enableLoginOTPFn()',
                        [disabled]='otpForm.invalid',
                        class='textColor'
                      ) Verify and Enable 2-Factor Authentication
                      | &nbsp;&nbsp;&nbsp;&nbsp;&emsp;
                      button.btn.btn-link(type='submit', (click)='onCancelLoginOTP()') Cancel
            div(*ngIf='isLoginOTPEnabled', style='margin-top: 32px;margin-bottom: 25px;')
