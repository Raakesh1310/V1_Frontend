form
  .form-group.form-inline.row.align-items-stretch
    .mt-1.col-xl-5.col-lg-8.col-md-8.col-sm-8
      input#search-box.mt-1.form-control.form-control-sm.w-100(
        type='text',
        name='s',
        placeholder='Search',
        [(ngModel)]='profileAdminService.searchTerm'
      )
    .mt-1.col-xl-3.col-lg-3.col-md-3.col-sm-3.d-flex.flex-row.align-items-end
      button.btn.btn-primary.btn-sm.mr-2(
        type='button',
        (click)='submitSearchForm()'
      ) Search
    .mt-1.col-xl-1.col-lg-1.col-md-1.col-sm-1.d-flex.flex-row.align-items-end
    a.btn.btn-success.btn-sm.mt-2.mr-2.ws-nowrap(
      type='button',
      target='_blank',
      [href]='profileAdminService.reportDownloadLink$ | async'
    )
      fa-icon.d-flex.flex-row.align-items-center.mr-2(
        [icon]='["fas", "arrow-down"]'
      )
      | Download
    span.ml-3(*ngIf='profileAdminService.loading$ | async') Loading...
  .table-responsive.pp-table-container.table-responsive-sm(
    *ngIf='(userProfiles$ | async)?.length > 0'
  )
    table.table
      thead
        tr
          th(scope='col', sbSortable='date', (sort)='onSort($event)')
            span.ws-nowrap User ID
          th(scope='col', sbSortable='event', (sort)='onSort($event)')
            span.ws-nowrap Business name
          th(scope='col', sbSortable='event', (sort)='onSort($event)')
            span Mobile
          th(scope='col', sbSortable='event', (sort)='onSort($event)')
            span.ws-nowrap GST Number
          th(scope='col', sbSortable='time', (sort)='onSort($event)')
            span.ws-nowrap PAN Number
          th(scope='col', sbSortable='time', (sort)='onSort($event)')
            span.ws-nowrap Authorized Person Name
          th(scope='col', sbSortable='time', (sort)='onSort($event)')
            span.ws-nowrap Authorized Person PAN
          th(scope='col', sbSortable='time', (sort)='onSort($event)')
            span.ws-nowrap GST Verified
          th(scope='col', sbSortable='time', (sort)='onSort($event)')
            span.ws-nowrap PAN Verified
          th(scope='col', sbSortable='time', (sort)='onSort($event)')
            span.ws-nowrap Authorized Person Pan Verified
          th(scope='col', sbSortable='time', (sort)='onSort($event)')
            span.ws-nowrap Cheque Verified
          th(scope='col', sbSortable='time', (sort)='onSort($event)')
            span.ws-nowrap Logo Verified
          th(scope='col', sbSortable='time', (sort)='onSort($event)')
            span Action
      tbody
        tr(*ngFor='let user of userProfiles$ | async')
          td
            ngb-highlight([result]='user.email')
          td
            ngb-highlight([result]='user.businessName')
          td
            ngb-highlight([result]='user.mobile')
          td
            ngb-highlight([result]='user.businessGst')
          td
            ngb-highlight([result]='user.businessPan')
          td
            ngb-highlight([result]='user.authorizedPersonName')
          td
            ngb-highlight([result]='user.authorizedPersonPan')
          td
            ngb-highlight([result]='user.docBusinessGstVerified ? "Yes" : "No"')
          td
            ngb-highlight([result]='user.docBusinessPanVerified ? "Yes" : "No"')
          td
            ngb-highlight(
              [result]='user.docAuthorizedPersonPanVerified ? "Yes" : "No"'
            )
          td
            ngb-highlight(
              [result]='user.docCancelledChequeVerified ? "Yes" : "No"'
            )
          td 
            ngb-highlight([result]='user.docBusinessLogoVerified ? "Yes" : "No"')
          td
            button.btn.btn-primary.btn-xs.mr-2.font-weight-700.ws-nowrap(
              type='button',
              (click)='showDetails(user, true)'
            ) Edit
  .d-flex.justify-content-between.p-2(
    *ngIf='(userProfiles$ | async)?.length > 0'
  )
    ngb-pagination(
      [collectionSize]='total$ | async',
      [(page)]='profileAdminService.page',
      [pageSize]='profileAdminService.pageSize'
    )
