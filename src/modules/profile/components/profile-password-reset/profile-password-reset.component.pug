div
  form([formGroup]='passForm', (ngSubmit)='sendOTP()')
    div(*ngIf='errors.length > 0')
      sbpro-alert(classes='alert-danger', [dismissable]='true')
        | {{ errors[0] }}
    div(*ngIf='success.length > 0')
      .alert.alert-success.alert-dismissible.fade.show(role='alert')
        span {{ success[0] }}
        button.close(type='button', (click)='success = []', aria-label='Close')
          span(aria-hidden='true') ×
    .form-group
      label(for='currentPassword') Current Password
        span.text-danger *
      input#currentPassword.form-control(
        type='password',
        placeholder='current password',
        formControlName='currentPassword',
        minlength=8,
        required
      )
    .form-group
      label(for='newPassword') New Password
        span.text-danger *
      input#newPassword.form-control(
        type='password',
        placeholder='new password',
        formControlName='newPassword',
        required,
        minlength=8
      )
    .form-group
      label(for='confirmPassword') Confirm Password
        span.text-danger *
      input#confirmPassword.form-control(
        type='password',
        placeholder='confirm password',
        formControlName='confirmPassword',
        required,
        minlength=8
      )
    button.btn(type='submit', [disabled]='!passForm.valid', class='castlerButtonColor') Update
