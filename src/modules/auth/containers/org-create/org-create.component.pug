sb-layout-auth
  .container
    .row.justify-content-center
      .col-xl-8.col-lg-8.col-md-8.col-sm-11
        .card.mt-5
          .card-body.p-3.text-center
            center
              img.logoImage(
                src='/assets/img/Castler_logo.png',
                width='100',
                height='50'
              )
            //- .h3.text-primary.font-weight-300.mb-0 Create an Organization
          hr.m-0
          .card-body.p-5
            form(
              [formGroup]='organizationNewForm',
              autocomplete='off',
              (ngSubmit)='onSubmit()'
            )
              .form-group
                input.form-control.form-control-solid(
                  data-cy='nameInput',
                  type='text',
                  placeholder='Enter new organization name',
                  aria-describedby='nameHelp',
                  formControlName='name',
                  [class.is-valid]='nameControlValid',
                  [class.is-invalid]='nameControlInvalid'
                )
                .invalid-feedback(*ngIf='nameControl.hasError("required")')
                  | Name required
                .invalid-feedback(*ngIf='nameControl.hasError("name")')
                  | Name is not available

              .form-group.mb-0
                button.btn.btn-block.btn-primary(
                  data-cy='organizationNewButton',
                  type='submit',
                  [disabled]='organizationNewForm.invalid'
                ) Create Organization
