sb-layout-auth
  .container
    .row.justify-content-center
      .col-xl-12.col-lg-12.col-md-12.col-sm-12
        .card.mt-5
          .card-body.p-3.text-center
            center
              img(
                src='/assets/img/Castler_logo.png',
                width='280',
                height='100'
              )
            //- .h3.text-primary.font-weight-300.mb-0 Create an Organization
          hr.m-0
          .card-body.p-5
            .container.text-center 
              h2 What type of Escrow would you like to create?
              h4 Choose Escrow type
            .container
              .row.justify-content-center
                // Create Organization
                .col-xl-5.col-lg-6.col-md-8.col-sm-11.mt-4
                  .card.text-center.h-100
                    .card-body.px-5.pt-5.d-flex.flex-column
                      div
                        .h3.font-weight-300(style="color: #417505") Individual Escrow
                        p.text-muted.mb-4 For Individuals/Peer to peer transactions
                      .icons-org-create.align-items-center.mx-auto.mt-auto
                        i-feather.icon-users(name='users', class="fill-red")
                        fa-icon.icon-plus([icon]='["fas", "plus"]')

                    .card-footer.bg-transparent.px-5.py-4
                      .small.text-center
                        a.btn.btn-block(
                          style="background: #417505;color: white"
                          data-cy='createNewOrganization',
                          routerLink='/auth/register-individual'
                        ) Sign Up
                // Join Organization
                .col-xl-5.col-lg-6.col-md-8.col-sm-11.mt-4
                  .card.text-center.h-100
                    .card-body.px-5.pt-5.d-flex.flex-column.align-items-between
                      div
                        .h3.font-weight-300(style="color: #FFB318") Enterprise Escrow
                        p.text-muted.mb-4 For Enterprise transactions
                      .icons-org-join.align-items-center.mx-auto
                        i-feather.icon-user(name='user')
                        fa-icon.icon-arrow.d-inline-flex(
                          [icon]='["fas", "long-arrow-alt-right"]'
                        )
                        i-feather.icon-users(name='users')
                    .card-footer.bg-transparent.px-5.py-4
                      .small.text-center
                        a.btn.btn-block(
                          style="background-image: linear-gradient(#e4b657,#a2751a);color: white;border:none"
                          data-cy='joinOrganization',
                          routerLink='/auth/register-enterprise'
                        ) Sign Up
          .card-footer.text-center
            .small
              a(routerLink='/auth/login',style='color: #417505;font-weight: 500;') Have an account? Go to login
