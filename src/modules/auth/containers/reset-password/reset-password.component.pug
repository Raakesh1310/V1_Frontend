sb-layout-auth
  .container
    .row.justify-content-center
      .col-lg-5
        .card.shadow-lg.border-0.rounded-lg.mt-5(*ngIf='!valid')
          .card-header.justify-content-center.text-danger
            | Link has expired.
        .card.shadow-lg.border-0.rounded-lg.mt-5(*ngIf='valid')
          .card-header.justify-content-center
            img.logoImage(
              src='/assets/img/Castler_logo.png',
              width='100',
              height='50'
            )
          .card-body
            div(*ngIf='errors.length > 0')
              sbpro-alert(classes='alert-danger', [dismissable]='true')
                | {{ errors[0] }}
            form([formGroup]='resetForm' autocomplete='off', (ngSubmit)='onReset()')
              .form-group
                label.small.mb-1(for='pass') New Password
                input#pass.form-control.py-4(
                  data-cy='passInput',
                  type='password',
                  placeholder='Enter new password',
                  formControlName='pass'
                )

              .form-group
                label.small.mb-1(for='confirm') Confirm New Password
                input#confirm.form-control.py-4(
                  data-cy='passInput',
                  type='password',
                  placeholder='Confirm new password',
                  formControlName='confirm'
                )
              .form-group(*ngIf='openOTPModal')
                label.small.mb-1(for='inputOTP') OTP
                input#inputOTP.form-control.py-4(
                  data-cy='otp',
                  type='text',
                  placeholder='Enter OTP sent on registered mobile number',
                  formControlName='otp',
                  maxLength=6
                )
              span(*ngIf='openOTPModal') Didn't receive an OTP? &nbsp;
                span(
                  (click)='resendOTP()',
                  [class.linker]='!timer',
                  style='color: #417505; font-weight:bold'
                ) Resend
                span(*ngIf='timer') ({{ counter }})
              .form-group 
                button.btn.btn-block.castlerButtonColor(
                  type='submit',
                  [disabled]='resetForm.invalid'
                ) Reset Password
              div 
                p Password should have:
                ol 
                  li Min 8 characters.
                  li Atleast 1 lower case and atleast 1 upper case.
                  li Atleast 1 numeric value.
                  li Atleast 1 special character like @, #, etc.
