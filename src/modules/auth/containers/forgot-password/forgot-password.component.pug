sb-layout-auth
  .container
    .row.justify-content-center
      .col-lg-5
        .card.shadow-lg.border-0.rounded-lg.mt-5(*ngIf='linkExpired')
          .card-header.justify-content-center.text-danger
            | Link has expired.
        .card.shadow-lg.border-0.rounded-lg.mt-5(*ngIf='!linkExpired')
          .card-header.justify-content-center
            img.logoImage(
              src='/assets/img/Castler_logo.png',
              width='100',
              height='50'
            )
          .card-body(*ngIf='key && !valid')
            center
              img.svgIcon(
                src='data:image/png;base64,'
              )
              hr
              span This reset link has been EXPIRED or INVALID

          .card-body(*ngIf='key && valid')
            div(*ngIf='errors.length > 0')
              sbpro-alert(classes='alert-danger', [dismissable]='true')
                | {{ errors[0] }}
            form([formGroup]='resetForm', autocomplete='off', (ngSubmit)='onReset()')
              .form-group
                label.small.mb-1(for='pass') New Password
                input#pass.form-control.py-4(
                  data-cy='passInput',
                  type='password',
                  placeholder='Enter new password',
                  formControlName='pass'
                )

              .form-group
                label.small.mb-1(for='confirm') Confirm New Password
                input#confirm.form-control.py-4(
                  data-cy='passInput',
                  type='password',
                  placeholder='Confirm new password',
                  formControlName='confirm'
                )

              .form-group 
                button.btn.btn-block.castlerButtonColor(
                  type='submit',
                  [disabled]='resetForm.invalid'
                ) Reset Password
              div 
                p Password should have:
                ol 
                  li Min 8 characters.
                  li Atleast 1 lower case and atleast 1 upper case.
                  li Atleast 1 numeric value.
                  li Atleast 1 special character like @, #, etc.
          .card-body(*ngIf='!key')
            div(*ngIf='errors.length > 0')
              sbpro-alert(classes='alert-danger', [dismissable]='true')
                | {{ errors[0] }}
            center
              span Enter your email address and we will send you a link to reset your password.
            hr
            form(
              [formGroup]='forgotPasswordForm',
              autocomplete='off',
              (ngSubmit)='onSubmit($event)'
            )
              .form-group
                label.small.mb-1(for='inputEmailAddress') Email
                input#inputEmailAddress.form-control.py-4(
                  data-cy='emailInput',
                  type='email',
                  placeholder='Enter email address',
                  aria-describedby='emailHelp',
                  formControlName='email',
                  [class.is-valid]='emailControlValid',
                  [class.is-invalid]='emailControlInvalid'
                )
                .invalid-feedback(*ngIf='emailControl.hasError("required")')
                  | Email required.
                .invalid-feedback(*ngIf='emailControl.hasError("email")')
                  | Email is not valid.

              .form-group 
                button.btn.btn-block.castlerButtonColor(
                  data-cy='resetPasswordButton',
                  type='submit',
                  [disabled]='forgotPasswordForm.invalid'
                ) Reset Password
            center(*ngIf='isDone')
              span A password reset link has been sent to "{{ email }}"

          .card-footer.text-center
            a.small.logoColor(routerLink='/auth/login') Return to login
