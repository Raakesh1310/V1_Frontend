sb-layout-auth
  .container
    .row.justify-content-center
      .col-lg-5
        .card.shadow-lg.border-0.rounded-lg.mt-5
          .card-header.justify-content-center
            img.logoImage(
              src='/assets/img/Castler_logo.png',
              width='100',
              height='50'
            )
          .card-body
            div
              sbpro-info
                | Link has expired. We have sent new verification email in your email ID.
          .card-footer.text-center
            .small
              a(routerLink='/auth/login', (click)='reset()') Go to Login Page
