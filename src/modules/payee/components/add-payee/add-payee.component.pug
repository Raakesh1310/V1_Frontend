.p-3
  div(*ngIf='!payeeIdProvided && showFirstDiv')
    div(*ngIf='errors.length > 0')
      .alert.alert-danger.alert-dismissible.fade.show(
        role='alert',
        *ngIf='errors.length > 0'
      )
        | {{ errors[0] }}
        button.close(
          type='button',
          (click)='errors = []',
          data-dismiss='alert',
          aria-label='Close'
        )
          span(aria-hidden='true') ×
    form([formGroup]='payeeForm' autocomplete='off', *ngIf='!payeeIdProvided')
      .row
        .col-6(*ngIf='payeeIdProvided')
          .form-group
            label(for='frm-cntrl-payeeId') Payee Id
            input#frm-cntrl-createdby.form-control.form-control-sm(
              type='text',
              [(ngModel)]='payeeId',
              [ngClass]='{ "non-editable": payeeIdProvided }',
              [readonly]='payeeIdProvided',
              [ngModelOptions]='{ standalone: true }'
            )
        .col-6(*ngIf='payeeIdProvided')
          .form-group
            label(for='frm-cntrl-addition-date') Addition Date
            input#frm-cntrl-addition-date.form-control.form-control-sm(
              type='text',
              [(ngModel)]='additionDate',
              [ngClass]='{ "non-editable": payeeIdProvided }',
              [readonly]='payeeIdProvided',
              [ngModelOptions]='{ standalone: true }'
            )
        .col-6
          .form-group
            label(for='frm-cntrl-accountHolder') Account Holder&apos;s Name
            span.text-danger *
            input#frm-cntrl-accountHolder.form-control.form-control-sm(
              type='text',
              placeholder='Payee Name',
              formControlName='accountHolder',
              name='accountHolder',
              [ngClass]='{ "non-editable": payeeIdProvided }',
              [readonly]='payeeIdProvided',
              autocomplete='new-payeeName',
              (keydown)='utilityService.onlyAlphaNumeric($event)'
            )
            span(
              *ngIf='accountHolder.invalid && (accountHolder.dirty || accountHolder.touched)'
            )
              span.text-danger(*ngIf='accountHolder.errors.required') Account holder&apos;s name is required.
            span.text-danger(*ngIf='nameError') {{ nameError }}
        .col-6
          .form-group
            label(for='frm-cntrl-email') Email
            span.text-danger *
            input#frm-cntrl-email.form-control.form-control-sm(
              type='email',
              placeholder='Please enter email',
              formControlName='email',
              [ngClass]='{ "non-editable": payeeIdProvided }',
              [readonly]='payeeIdProvided'
            )
            span(*ngIf='email.invalid && (email.dirty || email.touched)')
              span.text-danger(*ngIf='email.hasError("required")') Email is required.
              span.text-danger(
                *ngIf='!email.hasError("required") && email.hasError("email")' 
              ) Enter a valid email.
        .col-6
          .form-group
            label(for='frm-cntrl-mob-number') Mobile Number
            span.text-danger *
            input#frm-cntrl-mob-number.form-control.form-control-sm(
              type='tel',
              placeholder='Please enter 10 digit mobile number',
              formControlName='mobile',
              pattern='[0-9]{3}[0-9]{2}[0-9]{5}',
              [ngClass]='{ "non-editable": payeeIdProvided }',
              [readonly]='payeeIdProvided',
              (keydown)='onlyTenNumbers($event)'
            )
            span(*ngIf='mobile.invalid && (mobile.dirty || mobile.touched)')
              span.text-danger(*ngIf='mobile.errors.required') Mobile number is required.
              span.text-danger(
                *ngIf='mobile.errors.minlength || mobile.errors.maxlength || mobile.errors.pattern'
              ) Enter a valid mobile number.
        .col-6(*ngIf='payeeIdProvided')
          .form-group
            label(for='frm-cntrl-createdby') Created by ID
            input#frm-cntrl-createdby.form-control.form-control-sm(
              type='email',
              [(ngModel)]='createdBy',
              [ngClass]='{ "non-editable": payeeIdProvided }',
              [readonly]='payeeIdProvided',
              [ngModelOptions]='{ standalone: true }'
            )
      br
      .row
        .col-lg-3.col-md-6
          label.bold Bank Details 
          span.text-danger(*ngIf='!upiPayoutEnabled')
            | *         
      .row
        .col
          .form-group
            label(for='frm-cntrl-acc-number') Account Number
            span.text-danger(*ngIf='!upiPayoutEnabled')
              | *
            input#frm-cntrl-acc-number.form-control.form-control-sm(
              type='text',
              placeholder='Account Number',
              formControlName='accountNumber',
              maxlength=18,
              min='0',
              [ngClass]='{ "non-editable": payeeIdProvided }',
              [readonly]='payeeIdProvided',
              autocomplete='new-accountNumber'
            )
            span(
              *ngIf='accountNumber.invalid && (accountNumber.dirty || accountNumber.touched)'
            )
              span.text-danger(
                *ngIf='accountNumber.errors.Error == "Invalid Account Number"'
              ) Invalid Account Number.
              span.text-danger(*ngIf='accountNumber.errors.required') Account number is required.
              span.text-danger(
                *ngIf='accountNumber.errors.minlength || accountNumber.errors.maxlength || accountNumber.errors.pattern'
              ) Enter a valid account number.
        .col
          .form-group
            label(for='frm-cntrl-ifsc') IFSC Code
            span.text-danger(*ngIf='!upiPayoutEnabled')
              | *
            input#frm-cntrl-ifsc.aria-readonly.form-control.form-control-sm(
              type='text',
              placeholder='IFSC Code',
              formControlName='ifsc',
              maxlength='11',
              (focusout)='updateIfscDetails($event)',
              [ngClass]='{ "non-editable": payeeIdProvided }',
              [readonly]='payeeIdProvided',
              autocomplete='new-ifsc'
            )
            span(*ngIf='ifsc.invalid && (ifsc.dirty || ifsc.touched)')
              span.text-danger(*ngIf='ifsc.errors.required') IFSC is required.
              span.text-danger(
                *ngIf='ifsc.errors.minlength || ifsc.errors.maxlength || ifsc.errors.pattern'
              ) Enter a valid IFSC.
      .row
        .col
          .form-group
            label(for='frm-cntrl-bankName') Bank Name
            span.text-danger(*ngIf='!upiPayoutEnabled')
              | *
            input#frm-cntrl-bankName.form-control.form-control-sm(
              type='text',
              placeholder='Bank Name',
              formControlName='bankName',
              [ngClass]='{ "non-editable": payeeIdProvided }',
              [readonly]='payeeIdProvided || disabledBankNameAndBranch',
              autocomplete='new-bankName'
            )
            span(
              *ngIf='bankName.invalid && (bankName.dirty || bankName.touched)'
            )
              span.text-danger(*ngIf='bankName.errors.required') Bank name is required.
        .col
          .form-group
            label(for='frm-cntrl-ifsc') Bank Branch
            span.text-danger(*ngIf='!upiPayoutEnabled')
              | *
            input#frm-cntrl-bankAddress.aria-readonly.form-control.form-control-sm(
              type='text',
              placeholder='Bank Branch',
              formControlName='bankAddress',
              value='{{ bankBranch }}',
              [ngClass]='{ "non-editable": payeeIdProvided }',
              [readonly]='payeeIdProvided || disabledBankNameAndBranch',
              autocomplete='new-bankBranch'
            )
            span(
              *ngIf='bankAddress.invalid && (bankAddress.dirty || bankAddress.touched)'
            )
              span.text-danger(*ngIf='bankAddress.errors.required') Bank branch is required
      br
      .row(*ngIf='upiPayoutEnabled')
        .col-lg-3.col-md-6
          label.bold  UPI Details 
      .row(*ngIf='upiPayoutEnabled')
        .col-lg-3.col-md-6
          .form-group
            input#frm-cntrl-bankAddress.aria-readonly.form-control.form-control-sm(
              type='text',
              placeholder='UPI ID',
              formControlName='vpa',
              [ngClass]='{ "non-editable": payeeIdProvided }',
              [readonly]='payeeIdProvided'
            )
            span(*ngIf='vpa.invalid && (vpa.dirty || vpa.touched)')
              span.text-danger(*ngIf='vpa.errors.Error === "required"') UPI ID is required
        //- .col-lg-3.col-md-6
        //-     button.btn-sm.castlerButtonColor(type='button', (click)='verifyVPA()') Verify 
      br
      .row
        .col
          h5.display-6 Document(s)
      .row
        .col
          .form-group
            label(for='frm-cntrl-cheque') Cancelled Cheque
            //- span.text-danger
            //-   | *
            sbpro-file-input#frm-cntrl-cheque(
              *ngIf='!chequeFileName',
              placeholder='Upload File (Max size 5 MB)',
              [fileUrl]='chequeFileName',
              [fileTitle]='chequeFileTitle',
              formControlName='docCancelledCheque',
              accept='.png,.pdf,.jpg,.jpeg',
              (change) = "uploadFile($event)"
            )
            div(*ngIf='chequeFileName')
              a(href="#", (click)='downloadCheque($event)') {{ chequeFileTitle }}

      sbpro-app-button(
        (click)='sendOTP()',
        *ngIf='!payeeIdProvided && !submitted && !editMode',
        text='Add Payee',
        [loading]='loading$ | async',
        loadingText='Submitting..',
        [btnClass]='{ "btn-block": false, "btn-primary": true }'
        [disabled]='!fileSizeValid'
      )

