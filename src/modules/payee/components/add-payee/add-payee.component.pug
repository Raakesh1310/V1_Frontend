                type='text',
                placeholder='Bank Branch',
                value='{{payeeForm.get("bankAddress").value ? payeeForm.get("bankAddress").value : "--"}}',
                [ngClass]='{ "non-editable": payeeIdProvided }',
                [readonly]='payeeIdProvided',
                autocomplete='new-bankBranch'
              )
              span(
                *ngIf='bankAddress.invalid && (bankAddress.dirty || bankAddress.touched)'
              )
                span.text-danger(*ngIf='bankAddress.errors.required') Bank branch is required

        br
        .row(*ngIf='(upiPayoutEnabled && vpa !== "")')
          .col
            h5.display-6 UPI Details

        .row(*ngIf='(upiPayoutEnabled && vpa !== "")')
          .col-lg-3.col-md-6.col-sm-12
            .form-group
              input#frm-cntrl-bankAddress.aria-readonly.form-control.form-control-sm(
                type='text',
                placeholder='UPI ID',
                value='{{payeeForm.get("vpa").value ? payeeForm.get("vpa").value : "--"}}',
                [ngClass]='{ "non-editable": payeeIdProvided }',
                [readonly]='payeeIdProvided'
              )
              span(*ngIf='vpa.invalid && (vpa.dirty || vpa.touched)')
                span.text-danger(*ngIf='vpa.errors.Error === "required"') UPI ID is required

        br
        .row
          .col
            h5.display-6 Document(s)
        .row
          .col
            .form-group
              label(for='frm-cntrl-cheque') Cancelled Cheque
              //- span.text-danger
              //-   | *
              sbpro-file-input#frm-cntrl-cheque(
                *ngIf='!chequeFileName',
                placeholder='Upload File (Max size 5 MB)',
                [fileUrl]='chequeFileName',
                [fileTitle]='chequeFileTitle',
                formControlName='docCancelledCheque',
                (change) = "uploadFile($event)"
              )
              div(*ngIf='chequeFileName')
                a(href="#", (click)="downloadCheque($event)") {{ chequeFileTitle }} 
              //- div(*ngIf='bankName.errors.required') Cancelled Cheque is required.
        sbpro-app-button(
          (click)='sendOTP()',
          *ngIf='!payeeIdProvided && !submitted && !editMode',
          text='Add Payee',
          [loading]='loading$ | async',
          loadingText='Submitting..',
          [btnClass]='{ "btn-block": false, "btn-primary": true }'
          [disabled]='!fileSizeValid'
        )
        sbpro-app-button(
          (click)='onSubmit()',
          *ngIf='editMode',
          text='Update Payee',
          [loading]='loading$ | async',
          loadingText='Submitting..',
          [btnClass]='{ "btn-block": false, "btn-primary": true }'
        )
        button.btn.castlerButtonColor(
          (click)='goBack()',
          *ngIf='payeeIdProvided'
        ) Back
        | &nbsp;&nbsp;&nbsp;&nbsp;
        button.btn.castlerButtonColor(
          (click)='toggleEdit()',
          *ngIf='payeeIdProvided && !readOnly'
        ) Edit
ng-template(#detailsTemplate)
  sbpro-card([headerActions]='true')
    .card-header.logoColor
      | Account Details
    .card-body 
      | Account Holder name fetched as per Bank records is
      b {{ accountHolderName }}.
      br
      | Do you want to proceed and add payee?
    .card-footer
      span
        button.btn.btn-sm.btn-success.float-right((click)='onSubmit()') Add Payee
        span.float-right &nbsp;&nbsp;
        button.btn.btn-sm.btn-danger.float-right((click)='onCancel()') Cancel
    span.float-right &nbsp;&nbsp;

ngx-spinner
  p(style='font-size: 20px; color: white') Please wait while we verify your bank account...
