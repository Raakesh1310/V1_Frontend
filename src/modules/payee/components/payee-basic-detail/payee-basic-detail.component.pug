sbpro-card
  .card-header Add Payee
  .card-body
    form([formGroup]='payeeForm', (ngSubmit)='sendOTP()')
      .row
        .col
          h5.display-6 Payee Details
      .row
        .col
          .form-group
            label(for='frm-cntrl-accholder') Account Holder&apos;s Name
            span.text-danger *
            input#frm-cntrl-accholder.form-control.form-control-sm(
              type='text',
              placeholder='Payee Name',
              formControlName='accholder',
              name='accholder'
            )
          .alert.alert-danger(
            *ngIf='accholder.invalid && (accholder.dirty || accholder.touched)'
          )
            div(*ngIf='accholder.errors.required') Account holder&apos;s name is required.
        .col
          .form-group
            label(for='frm-cntrl-mob-number') Mobile Number
            span.text-danger *
            input#frm-cntrl-mob-number.form-control.form-control-sm(
              type='tel',
              placeholder='Please enter 10 digit mobile number',
              formControlName='mobnumber',
              pattern='[0-9]{3}[0-9]{2}[0-9]{5}'
            )
          .alert.alert-danger(
            *ngIf='mobnumber.invalid && (mobnumber.dirty || mobnumber.touched)'
          )
            div(*ngIf='mobnumber.errors.required') Mobile number is required.
            div(
              *ngIf='mobnumber.errors.minlength || mobnumber.errors.maxlength || mobnumber.errors.pattern'
            ) Insert a valid mobile number.
      br
      .row
        .col
          h5.display-6 Bank Details
      .row
        .col
          .form-group
            label(for='frm-cntrl-acc-number') Account Number
            span.text-danger
              | *
            input#frm-cntrl-acc-number.form-control.form-control-sm(
              type='text',
              placeholder='Account Number',
              formControlName='accnumber',
              maxlength=18,
              min='0'
            )
          .alert.alert-danger(
            *ngIf='accnumber.invalid && (accnumber.dirty || accnumber.touched)'
          )
            div(*ngIf='accnumber.errors.required') Account number is required.
            div(
              *ngIf='accnumber.errors.minlength || accnumber.errors.maxlength || accnumber.errors.pattern'
            ) Insert a valid account number.
        .col
          .form-group
            label(for='frm-cntrl-ifsc') IFSC Code
            span.text-danger
              | *
            input#frm-cntrl-ifsc.aria-readonly.form-control.form-control-sm(
              type='text',
              placeholder='IFSC Code',
              autocomplete='off',
              formControlName='ifsc',
              maxlength='11',
              (focusout)='ifscDetails($event)'
            )
          .alert.alert-danger(
            *ngIf='ifsc.invalid && (ifsc.dirty || ifsc.touched)'
          )
            div(*ngIf='ifsc.errors.required') IFSC code is required.
            div(
              *ngIf='ifsc.errors.minlength || ifsc.errors.maxlength || ifsc.errors.pattern'
            ) Insert a valid ifsc code.
      .row
        .col
          .form-group
            label(for='frm-cntrl-bankname') Bank Name
            span.text-danger
              | *
            input#frm-cntrl-bankname.form-control.form-control-sm(
              type='text',
              placeholder='{{ bankName }}',
              formControlName='bankname',
              value='{{ bankName }}'
            )
          .alert.alert-danger(
            *ngIf='bankname.invalid && (bankname.dirty || bankname.touched)'
          )
            div(*ngIf='bankname.errors.required') Bank name is required.
        .col
          .form-group
            label(for='frm-cntrl-ifsc') Bank Branch
            input#frm-cntrl-bankadd.aria-readonly.form-control.form-control-sm(
              type='text',
              placeholder='{{ bankBranch }}',
              autocomplete='off',
              formControlName='bankadd',
              value='{{ bankBranch }}'
            )
          .alert.alert-danger(
            *ngif='bankadd.invalid && (bankadd.dirty || bankadd.touched)'
          )
            div(*ngif='bankadd.errors.required') Bank name is required
      button.btn.btn-primary(type='submit') Add Payee
