div
    div(*ngIf='errors.length > 0')
        sbpro-alert(classes='alert-danger', [dismissable]='true', (click)='errors = []')
            | {{ errors[0] }}
    div
        form.pb-2(*ngIf='filtersVisible')
            .d-flex.mb-2
                input#wildSearch.mt-1.form-control.w-100.mr-2(
                    placement='top',
                    ngbPopover='Search by Business Name, Virtual ID, Payment ID, Beneficiary Name'
                    type='text',
                    name='s',
                    autocomplete='off',
                    placeholder='Search by Business Name, Virtual ID, Payment ID, Beneficiary Name',
                    [(ngModel)]='transferService.searchTerm'
                )

                input#start-date.mt-1.form-control.w-25.mr-2(
                    type='text',
                    name='sd',
                    placeholder='Start Date',
                    autocomplete='off',
                    ngbDatepicker,
                    outsideDays='hidden',
                    #sd='ngbDatepicker',
                    (click)='sd.toggle()',
                    [(ngModel)]='transferService.dateFrom',
                    [minDate]='transferService.dateFromMin',
                    [maxDate]='transferService.dateFromMax'
                )
                input#end-date.mt-1.form-control.w-25.mr-2(
                    type='text',
                    name='ed',
                    placeholder='End Date',
                    autocomplete='off',
                    ngbDatepicker,
                    outsideDays='hidden',
                    #ed='ngbDatepicker',
                    (click)='ed.toggle()',
                    [(ngModel)]='transferService.dateTo',
                    [minDate]='transferService.dateToMin',
                    [maxDate]='transferService.dateToMax'
                )

                select.mt-1.form-control.w-25.mr-2(
                    name='bank',
                    [(ngModel)]='transferService.bank',
                    *ngIf='!isTrustee'
                )
                    option(value='') Select Bank
                    option(value='icici') ICICI
                    option(value='rbl') RBL
                    option(value='yes_bank') YES BANK
                    option(value='idfc') IDFC
                    option(value='ibl') IndusInd
                    option(value='hdfc') HDFC
                    option(value='dbs') DBS
                    option(value='axis') AXIS

                select#statusList.mt-1.form-control.w-25.mr-2(
                    name='status',
                    [(ngModel)]='transferService.status'
                )
                    option(value='') Status
                    option(*ngFor='let st of statusList', [ngValue]='st') {{ st }}


                button.btn.ws-nowrap.mt-1.mb-1.pt-2(
                    type='submit',
                    class= 'castlerButtonColor',
                    (click)='submitSearchForm()'
                )
                    fa-icon.d-flex.flex-row.align-items-center(
                        [icon]='["fas", "search"]'
                    )

                button.btn.btn-link.mt-1(type='button', (click)='clearForm()' class='logoColor') Clear

                .justify-content-end
                    a.btn.mt-1.mb-1.btn-success.ws-nowrap.btn-icon(
                        type='button',
                        target='_blank',
                        [href]='transferService.reportDownloadLink$ | async'
                    )
                        fa-icon.d-flex.flex-row.align-items-center(
                            [icon]='["fas", "arrow-down"]'
                        )

            .d-flex(*ngIf='(transfers$ | async)?.length > 0')
                .flex-row
                    small.mb-2.mt-2 Showing {{  (transferService.page - 1)  * 10 + 1 }} to {{ (transferService.page - 1)  * 10 +  (transfers$ | async)?.length  }} of {{total$ | async}}

    .table-responsive.pp-table-container.align-self-stretch.flex-grow-1.flex-stretch-1.table-striped(
        *ngIf='(transfers$ | async)?.length > 0 && !(loadingList$ | async)'
    )
        table.table
            thead
                tr
                    th.th-sticky-top(
                        scope='col',
                        sbSortable='event',
                        (sort)='onSort($event)'
                    )
                        span.ws-nowrap Business name
                    th.th-sticky-top(
                        scope='col',
                        sbSortable='event',
                        (sort)='onSort($event)'
                    )
                        span.ws-nowrap Payment ID
                    th.th-sticky-top(scope='col' sbSortable='time', (sort)='onSort($event)')
                        span.ws-nowrap Request Date
                    th.th-sticky-top(scope='col' sbSortable='time', (sort)='onSort($event)')
                        span.ws-nowrap Last Updation Date
                    th.th-sticky-top(scope='col' sbSortable='time', (sort)='onSort($event)')
                        span.ws-nowrap From Escrow ID
                    th.th-sticky-top(scope='col' sbSortable='time', (sort)='onSort($event)')
                        span.ws-nowrap Beneficiary Name
                    th.th-sticky-top(scope='col' sbSortable='time', (sort)='onSort($event)')
                        span.ws-nowrap Beneficiary Bank
                    th.th-sticky-top(scope='col' sbSortable='time', (sort)='onSort($event)')
                        span.ws-nowrap Beneficiary A/C
                    th.th-sticky-top(scope='col' sbSortable='time', (sort)='onSort($event)')
                        span Amount
                    th.th-sticky-top(scope='col' sbSortable='time', (sort)='onSort($event)')
                        span UTR
                    th.th-sticky-top(scope='col' sbSortable='time', (sort)='onSort($event)')
                        span Status
                    th.th-sticky-top(scope='col' sbSortable='time', (sort)='onSort($event)')
                        span Remark
                    th.th-sticky-top(scope='col' sbSortable='time', (sort)='onSort($event)', *ngIf='!readOnly')
                        span Action
            tbody                
                tr
                    td(
                        *ngIf='!(transferService.loading$ | async) && (transfers$ | async)?.length == 0'
                    ) No Entries Found
                    td.spinner(*ngIf='transferService.loading$ | async')
                        .spinner-border.text-primary(role='status')
                        span.sr-only Loading...
                tr(*ngFor='let transfer of transfers$ | async; index as i')
                    td
                        a.nav-link.p-0(
                            class='tableClickEntryColor',
                            href='javascript:void(0);',
                            (click)='openMerchantDetails(transfer.merchantId)'
                        )
                            ngb-highlight(
                                [result]='transfer.merchantTitle',
                                [term]='transferService.searchTerm',
                            )
                    td
                        a.nav-link.p-0(
                            class='tableClickEntryColor',
                            href='javascript:void(0);',
                            (click)='openTransferDetails(transfer.transferId)'
                        )
                            ngb-highlight(
                                [result]='transfer.transferId',
                                [term]='transferService.searchTerm'
                            )
                    td
                        ngb-highlight.ws-nowrap(
                            [result]='transfer.createdAt | date: "d MMM yyyy" || "--"',
                            [term]='transferService.searchTerm'
                        )
                    td
                        ngb-highlight(
                            [result]='transfer.updatedAt | date: "d MMM yyyy" || "--"',
                            [term]='transferService.searchTerm'
                        )
                    td
                        a.nav-link.p-0(
                            class='tableClickEntryColor',
                            href='javascript:void(0);',
                            (click)='openDetails(transfer.accountId)'
                        )
                            ngb-highlight(
                                [result]='transfer.accountId',
                                [term]='transferService.searchTerm'
                            )
                    td
                        ngb-highlight(
                            [result]='transfer.beneficiaryName',
                            [term]='transferService.searchTerm'
                        )
                    td
                        ngb-highlight(
                            [result]='transfer.beneficiaryBankName || "--"',
                            [term]='transferService.searchTerm'
                        )
                    td
                        ngb-highlight(
                            [result]='transfer.beneficiaryAccNumber || transfer.vpa',
                            [term]='transferService.searchTerm'
                        )
                    td
                        ngb-highlight(
                            [result]='toINR(transfer.amount?.toFixed(2))',
                            [term]='transferService.searchTerm'
                        )
                    td
                        span(
                            *ngIf='!transfer.utr && !(enableEdit && enableEditIndex == i)'
                        ) --
                        ngb-highlight(
                            [result]='transfer.utr',
                            [term]='transferService.searchTerm',
                            *ngIf='!enableEdit'
                        )
                        input#utr.min-w-150px.mt-1.form-control.form-control-sm.w-100(
                            type='text',
                            [(ngModel)]='transfer.utr',
                            name='utr',
                            *ngIf='enableEdit && enableEditIndex == i'
                        )
                    td(*ngIf = 'isTrustee')
