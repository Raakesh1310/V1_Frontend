div
  form
    .d-flex.mb-2
      input#search-box.mt-1.form-control.w-50(
        type='text',
        placement='top',
        autocomplete='off',
        name='s',
        placeholder='Search',
        [(ngModel)]='searchTerm'
      )
      button.btn.mr-2.ml-2.ws-nowrap.mb-1.mt-1(
        class='castlerButtonColor',
        type='submit',
        (click)='submitSearchForm()'
      )
        fa-icon.d-flex.flex-row.align-items-center([icon]='["fas", "search"]')
      button.btn.btn-link.mt-1.mb-1.mr-2(
        type='button',
        class='logoColor',
        (click)='clearSearchForm()'
      )
        | Clear
    //.form-group.form-inline.row.align-items-stretch
