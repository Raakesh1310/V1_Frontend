	.row
		.col-md-6(*ngIf='showMerchantAuthorizer')
			//label Authorizers(s)
			div {{ showAccountAuthorizer ? "Level 1 Authorizer" : "Authorizers" }}
			angular2-multiselect(
				[data]='dropdownListMerchantAuthorizers',
				[(ngModel)]='selectedMerchantAuthorizers',
				[settings]='dropdownSettings',
				[ngModelOptions]='{ standalone: true }'
			)
		.col-md-6(*ngIf='showAccountAuthorizer')
			//label Authorizers(s)
			div {{ showMerchantAuthorizer ? "Level 2 Authorizer" : "Authorizers" }}
			angular2-multiselect(
				[data]='dropdownListAccountAuthorizers',
				[(ngModel)]='selectedAccountAuthorizers',
				[settings]='dropdownSettings',
				[ngModelOptions]='{ standalone: true }'
			)
