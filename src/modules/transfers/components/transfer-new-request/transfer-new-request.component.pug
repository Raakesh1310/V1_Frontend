		//  type='text',
		//  placeholder='Purpose of the transfer',
		//  formControlName ='purpose',
		//  name='purpose'
		//)

	br
	h5(*ngIf = '!connectedBanking') Additional Transfer Request
	hr
	.form-group(*ngIf = '!connectedBanking')
		label &nbsp; Add Recurring Transfer
		br
		label.switch
			input(
				type='checkbox',
				#checkbox,
				[disabled]='isDetailPage',
				[checked]='isRecurring',
				(click)='checkboxAction($event)'
			)
			span.slider.round
	.row
		.col-xl-3.col-lg-3.col-md-3.col-sm-12
			.form-group(*ngIf='isRecurring')
				label(for='frm-cntrl-start-date') Start Date
				input#frm-cntrl-start-date.aria-readonly.form-control.form-control-sm(
					type='text',
					placeholder='DD MM YYYY',
					autocomplete='off',
					[(ngModel)]='startDate',
					name='startDate',
					ngbDatepicker,
					outsideDays='hidden',
					#d='ngbDatepicker',
					(click)='d.toggle()',
					[minDate]='minDate1',
					[ngModelOptions]='{ standalone: true }'
				)
		.col-xl-3.col-lg-3.col-md-3.col-sm-12
			.form-group(*ngIf='isRecurring')
				.form-check-label
					| Frequency
				select#frm-cntrl-account.selecter.aria-readonly.form-control.form-control-sm(
					name='account',
					[(ngModel)]='selectedFrequency',
					[ngModelOptions]='{ standalone: true }'
				)
					option(value='') Please Select
					option(*ngFor='let f of frequencies', [ngValue]='f') {{ f }}
		.col-xl-3.col-lg-3.col-md-3.col-sm-12
			.form-group(*ngIf='isRecurring && selectedFrequency')
				label(for='recurrence') Repeat for
				input#recurrence.form-control.form-control-sm(
					type='text',
					[(ngModel)]='repeat',
					[ngModelOptions]='{ standalone: true }',
					placeholder='Enter billing frequency',
					name='repeat',
					(keydown)='onlyTenNumbers($event)'
				)
		.col-xl-3.col-lg-3.col-md-3.col-sm-12
			span.freq(*ngIf='selectedFrequency === "Daily"') Day
			span.freq(*ngIf='selectedFrequency === "Weekly"') Week
			span.freq(*ngIf='selectedFrequency === "Monthly"') Month
			span.freq(*ngIf='selectedFrequency === "Quarterly"') Quarter
	.row(*ngIf='!isAdmin')
		.col-sm-12.customCheckBoxWidth
			input(
				type='checkbox',
				#tcCheckbox,
				name='tcCheckbox',
				formControlName='tcCheckBox',
				(click)='tcCheckboxAction(tcCheckbox)'
			)
		.col-sm-12.col-md-6.col-lg-6
			label(for='tcCheckbox') 
				| I agree to the
				a.logoColor(
					href='https://castler.com/domestic-tcs/',
					target='_blank'
				) Terms and Conditions

	.row
		.col
			sbpro-app-button(
				text='Request Transfer',
				type='submit',
				value='submit',
				[loading]='loading$ | async',
				loadingText='Submitting..',
				[disabled]='addSupportingDocuments && (!uploadedDocuments || uploadedDocuments?.length <= 0)',
				[btnClass]='{ "btn-block": false, "btn-primary": true }',
				(click)='sendOTP()'
			)
		.col
			.text-danger(*ngIf='submitted && createTransferError')
				| {{ createTransferError }}
		//- [disabled]='submitted'
		//button.btn.btn-primary(type='submit', *ngIf='!submitted') Request Transfer
		//button.btn.btn-primary(*ngIf='submitted', [disabled]='submitted')
		//  span.spinner-border.spinner-border-sm(role='status' aria-hidden='true')
		//  | &nbsp; Submitting...

ngx-spinner
	p(style='font-size: 20px; color: white') Initiating Transfer...
