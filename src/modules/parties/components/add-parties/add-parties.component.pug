.p-5    
    form(
        [formGroup]='partyForm',
        autocomplete='off'
    )
        div
            h4 Escrow Party Details
            hr
        .alert.alert-danger.alert-dismissible.fade.show(
            *ngIf='profileErrors && profileErrors.length > 0',
            role='alert'
        )
            ul
                li(*ngFor='let error of profileErrors')
                    p.redDot {{ error }}
            button.close(
                type='button',
                data-dismiss='alert',
                aria-label='Close',
                (click)='profileErrors = []'
            )
                span(aria-hidden='true') &times;
        .d-flex
            .form-group.flex-even.mr-3
                label(for='business-name')
                    | Business Name (As mentioned in GST)
                    span.text-danger *
                    span.ml-1(*ngIf='businessVerified')
                        i-feather.text-success(name='check-circle')
                input#business-name.form-control(
                    type='text',
                    placeholder='Business Name',
                    formControlName='businessName',
                    value='{{ partyForm.controls.businessName.value }}',
                    [ngClass]='{ "non-editable": isReadonly || readOnly }',
                    [readonly]='isReadonly'
                )
                br(*ngIf='updateValues.updateBusinessName')
                span.update(*ngIf='updateValues.updateBusinessName') Updated Value: {{ updateValues.updateBusinessName }}
            .form-group.flex-even
                label(for='business-type')
                    | Business Type
                    span.text-danger *
                    span.ml-1(*ngIf='businessVerified')
                        i-feather.text-success(name='check-circle')
                select#business-type.form-control(
                    formControlName='businessType',
                    (change)='updateBusinessType()',
                    *ngIf='!isReadonly && !readOnly'
                )
                    option(value='Select Business Type') Select Business Type
                    option(*ngFor='let item of dropdown', [value]='item') {{ item }}
                input#business-type-input.form-control(
                    type='text',
                    formControlName='businessType',
                    [ngClass]='{ "non-editable": (isReadonly || readOnly)}',
                    [readonly]='isReadonly || readOnly',
                    *ngIf='isReadonly || readOnly'
                )
                br(*ngIf='updateValues.updateBusinessType')
                span.update(*ngIf='updateValues.updateBusinessType') Updated Value: {{ updateValues.updateBusinessType }}
        .d-flex
            .form-group.flex-even.mr-3
                label(for='gstNo')
                    | GST Number
                    span.text-danger *
                    span.ml-1(*ngIf='businessVerified')
                        i-feather.text-success(name='check-circle')
                input#gstNo.form-control(
                    type='text',
                    placeholder='XXXXXXXXXXXXXXX',
                    formControlName='businessGst',
                    value='{{ partyForm.controls.businessGst.value }}',
                    [ngClass]='{ "non-editable": isReadonly || readOnly }',
                    [readonly]='isReadonly'
                )
                p(style='color: green', *ngIf='businessVerifiedTime') Verified on
                    | &nbsp; {{ getDate(businessVerifiedTime) }}
                br(*ngIf='updateValues.updateBusinessGst')
                span.update(*ngIf='updateValues.updateBusinessGst') Updated Value: {{ updateValues.updateBusinessGst }}
            .form-group.flex-even
                label(for='companyPan')
                    | Business PAN
                    span.text-danger *
                    span.ml-1(*ngIf='businessVerified')
                        i-feather.text-success(name='check-circle')
                input#companyPan.form-control(
                    type='text',
                    placeholder='XXXXXXXXXX',
                    formControlName='businessPan',
                    value='{{ partyForm?.controls?.businessPan?.value }}',
                    [ngClass]='{ "non-editable": isReadonly || readOnly }',
                    [readonly]='isReadonly'
                )
                p(style='color: green', *ngIf='businessVerifiedTime') Verified on
                    | &nbsp; {{ getDate(businessVerifiedTime) }}
                br(*ngIf='updateValues.updateBusinessPan')
                span.update(*ngIf='updateValues.updateBusinessPan') Updated Value: {{ updateValues.updateBusinessPan }}
    form([formGroup]='addressForm' autocomplete='off')
        div
            .form-block
                h4 Address Details
                hr
            .flex-display
                .form-group.flex-even.mr-3
                    label(for='address')
                        | Address
                        span.text-danger *
                        span.ml-1(*ngIf='businessVerified')
                            i-feather.text-success(name='check-circle')
                    input#address.form-control(
                        type='text',
                        placeholder='Business Address',
                        formControlName='addressLine',
                        value='{{ addressForm.controls.addressLine.value }}',
                        [ngClass]='{ "non-editable": isReadonly || readOnly }',
                        [readonly]='isReadonly',
                        autocomplete='new-addressLine'
                    )
                    br(*ngIf='updateValues.updateAddressLine')
                    span.update(*ngIf='updateValues.updateAddressLine') Updated Value: {{ updateValues.updateAddressLine }}
                .form-group.flex-even
                    label(for='pinCode')
                        | Pin code
                        span.text-danger *
                        span.ml-1(*ngIf='businessVerified')
                            i-feather.text-success(name='check-circle')
                    input#pinCode.form-control(
                        type='text',
                        placeholder='Enter your 6 digit pincode',
                        formControlName='pinCode',
                        value='{{ addressForm.controls.pinCode.value }}',
                        [ngClass]='{ "non-editable": isReadonly || readOnly }',
                        [readonly]='isReadonly',
                        autocomplete='new-pin'
                    )
                    br(*ngIf='updateValues.updatePinCode')
                    span.update(*ngIf='updateValues.updatePinCode') Updated Value: {{ updateValues.updatePinCode }}
            .flex-display
                .form-group.flex-even.mr-3
                    label(for='city')
                        | City
                        span.text-danger *
                        span.ml-1(*ngIf='businessVerified')
                            i-feather.text-success(name='check-circle')
                    input#city.form-control(
                        type='text',
                        placeholder='City',
                        formControlName='city',
                        value='{{ addressForm.controls.city.value }}',
                        [ngClass]='{ "non-editable": isReadonly || readOnly }',
                        [readonly]='isReadonly',
                        autocomplete='new-city'
                    )
                    br(*ngIf='updateValues.updateCity')
                    span.update(*ngIf='updateValues.updateCity') Updated Value: {{ updateValues.updateCity }}
                .form-group.flex-even
                    label(for='state')
                        | State
                        span.text-danger *
                        span.ml-1(*ngIf='businessVerified')
                            i-feather.text-success(name='check-circle')
                    input#state.form-control(
                        type='text',
                        placeholder='State',
                        formControlName='state',
                        value='{{ addressForm.controls.state.value }}',
                        [ngClass]='{ "non-editable": isReadonly || readOnly }',
                        [readonly]='isReadonly'
                    )
                    br(*ngIf='updateValues.updateState')
                    span.update(*ngIf='updateValues.updateState') Updated Value: {{ updateValues.updateState }}

    .flex-display.mb-2.mt-5
        h4.mr-3 Bank Details
    .alert.alert-danger.alert-dismissible.fade.show(
        role='alert',
        *ngIf='bankFormErrors.length > 0'
    )
        ul
            li(*ngFor='let error of bankFormErrors')
                p.redDot {{ error }}
        button.close(
            type='button',
            data-dismiss='alert',
            aria-label='Close',
            (click)='bankFormErrors = []'
        )
            span(aria-hidden='true') &times;
    hr
    form([formGroup]='bankForm' autocomplete='off')
        .form-block
            .d-flex
                .form-group.flex-even.mr-3
                    label(for='accountNo')
                        | Account Number
                        span.text-danger *
                        span.ml-2(*ngIf='bankAccountVerified')
                            i-feather.text-success(name='check-circle')
                    input.form-control(
                        type='text',
                        placeholder='Account Number',
                        formControlName='accountNo',
                        required,
                        value='{{ bankForm.controls.accountNo.value }}',
                        [ngClass]='{ "non-editable": isReadonly || readOnly }',
                        [readonly]='isReadonly',
                        autocomplete='new-addressLine'
                    )
                    p(
                        style='color: green',
                        *ngIf='bankAccountVerified && bankForm.controls["bankVerifiedAt"].value'
                    ) Verified on
                        | &nbsp; {{ getDate(bankForm.controls["bankVerifiedAt"].value) }}
                    br(*ngIf='updateValues.updateAccountNo')
                    span.update(*ngIf='updateValues.updateAccountNo') Updated Value: {{ updateValues.updateAccountNo }}
                .form-group.flex-even
                    label(for='bankName')
                        | IFSC
                        span.text-danger *
                        span.ml-2(*ngIf='bankAccountVerified')
                            i-feather.text-success(name='check-circle')
                    input.form-control(
                        type='text',
                        placeholder='Ifsc',
                        formControlName='ifsc',
                        value='{{ bankForm.controls.ifsc.value }}',
                        required,
                        (focusout)='updateIfscDetails($event)',
                        [ngClass]='{ "non-editable": isReadonly || readOnly }',
                        [readonly]='isReadonly',
                        autocomplete='new-addressLine'
                    )
                    br(*ngIf='updateValues.updateIfsc')
                    span.update(*ngIf='updateValues.updateIfsc') Updated Value: {{ updateValues.updateIfsc }}
            .d-flex
                .form-group.flex-even.mr-3
                    label(for='ifsc')
                        | Bank Name
                        span.text-danger *
                    input.form-control(
                        type='text',
                        placeholder='Bank Name',
                        formControlName='bankName',
                        value='{{ bankForm.controls.bankName.value }}',
                        required,
                        [ngClass]='{ "non-editable": isReadonly || readOnly }',
                        [readonly]='isReadonly',
                        autocomplete='new-addressLine'
                    )
                    br(*ngIf='updateValues.updateBankName')
                    span.update(*ngIf='updateValues.updateBankName') Updated Value: {{ updateValues.updateBankName }}
                .form-group.flex-even
                    label(for='bankBranch')
                        | Bank Branch
                        span.text-danger *
                    input.form-control(
                        type='text',
                        placeholder='Bank Branch',
                        formControlName='bankBranch',
                        value='{{ bankForm.controls.bankBranch.value }}',
                        required,
                        [ngClass]='{ "non-editable": isReadonly || readOnly }',
                        [readonly]='isReadonly',
                        autocomplete='new-addressLine'
                    )
                    br(*ngIf='updateValues.updateBankBranch')
                    span.update(*ngIf='updateValues.updateBankBranch') Updated Value: {{ updateValues.updateBankBranch }}

    // Promoters start here.....
    .flex-display.mt-5.mb-4
        h4.mr-3 Promoter Details ({{ promoterForm.controls.length }})
        button.btn.castlerButtonColor(
            *ngIf='editMode',
            (click)='addPromoter()'
        )
            span + Add
    .alert.alert-danger.alert-dismissible.fade.show(
        role='alert',
        *ngIf='promoterFormErrors.length > 0'
    )
        ul
            li(*ngFor='let error of promoterFormErrors')
                p.redDot {{ error }}
        button.close(

            type='button',
            data-dismiss='alert',
            aria-label='Close',
            (click)='promoterFormErrors = []'
        )
            span(aria-hidden='true') &times;
    hr
    div(*ngFor='let promoter of promoterForm.controls; index as i')
        br
        ng-container([formGroup]='promoter')
            .d-flex
                .form-group.flex-even.mr-3
                    label(for='firstName')
                        | First Name
                    input.form-control(
                        type='text',
                        placeholder='First Name',
                        formControlName='firstName',
                        value='{{ promoterForm.at(i).value.firstName }}',
                        required,
                        [ngClass]='{ "non-editable": isReadonly || readOnly }',
                        [readonly]='isReadonly',
                        autocomplete='new-addressLine'
                    )
                    br(*ngIf='promoterForm.at(i).value.updateFirstName')
                    span.update(*ngIf='promoterForm.at(i).value.updateFirstName') Updated Value: {{ promoterForm.at(i).value.updateFirstName }}
                .form-group.flex-even
                    label(for='lastName')
                        | Last Name
                    input.form-control(
                        type='text',
                        placeholder='Last Name',
                        formControlName='lastName',
                        value='{{ promoterForm.at(i).value.lastName }}',
                        required,
                        [ngClass]='{ "non-editable": isReadonly || readOnly }',
                        [readonly]='isReadonly',
                        autocomplete='new-addressLine'
                    )
                    br(*ngIf='promoterForm.at(i).value.updateLastName')
                    span.update(*ngIf='promoterForm.at(i).value.updateLastName') Updated Value: {{ promoterForm.at(i).value.updateLastName }}
            .d-flex
                .form-group.flex-even.mr-3
                    label(for='mobile')
                        | Phone Number
                    input.form-control(
                        type='text',
                        placeholder='Mobile',
                        formControlName='mobile',
                        value='{{ promoterForm.at(i).value.mobile }}',
                        required,
                        [ngClass]='{ "non-editable": isReadonly || readOnly }',
                        [readonly]='isReadonly',
                        autocomplete='new-addressLine'
                    )
                    br(*ngIf='promoterForm.at(i).value.updateMobile')
                    span.update(*ngIf='promoterForm.at(i).value.updateMobile') Updated Value: {{ promoterForm.at(i).value.updateMobile }}
                .form-group.flex-even
                    label(for='email')
                        | Email
                    input.form-control(
                        type='text',
                        placeholder='Emial',
                        formControlName='email',
                        value='{{ promoterForm.at(i).value.email }}',
                        required,
                        [ngClass]='{ "non-editable": isReadonly || readOnly }',
                        [readonly]='isReadonly',
                        autocomplete='new-addressLine'
                    )
                    br(*ngIf='promoterForm.at(i).value.updateEmail')
                    span.update(*ngIf='promoterForm.at(i).value.updateEmail') Updated Value: {{ promoterForm.at(i).value.updateEmail }}
            .d-flex
                .form-group.flex-even.mr-3
                    label(for='pan')
                        | Pan
                    input.form-control(
                        type='text',
                        placeholder='Pan',
                        formControlName='authorizedPersonPan',
                        value='{{ promoterForm.at(i).value.authorizedPersonPan }}',
                        required,
                        [ngClass]='{ "non-editable": isReadonly || readOnly }',
                        [readonly]='isReadonly',
                        autocomplete='new-addressLine'
                    )
                    br(*ngIf='promoterForm.at(i).value.updateAuthorizedPersonPan')
                    span.update(*ngIf='promoterForm.at(i).value.updateAuthorizedPersonPan') Updated Value: {{ promoterForm.at(i).value.updateAuthorizedPersonPan }}
                .form-group.flex-even
                    label(for='aadhaar')
                        | Aadhaar
                    input.form-control(
                        type='text',
                        placeholder='Aadhaar',
                        formControlName='aadhar',
                        value='{{ promoterForm.at(i).value.aadhar }}',
                        required,
                        [ngClass]='{ "non-editable": isReadonly || readOnly }',
                        [readonly]='isReadonly',
                        autocomplete='new-addressLine'
                    )
                    br(*ngIf='promoterForm.at(i).value.updateAadhar')
                    span.update(*ngIf='promoterForm.at(i).value.updateAadhar') Updated Value: {{ promoterForm.at(i).value.updateAadhar }}
            .d-flex.justify-content-end
                button.btn.btn-light.mb-3(
                    (click)='removePromoter(i)',
                    *ngIf='promoterForm.controls.length > 1 && i != 0 && !isReadonly',
                    [disabled]='!editMode'
                )
                    i-feather(name='trash-2')


    button.btn.castlerButtonColor(*ngIf='!partyId', (click)='addParty()') Add Escrow Party
    button.btn.castlerButtonColor(*ngIf='partyId && editMode && !readOnly', (click)='updateParty()') Save
    span &nbsp;&nbsp;
    button.btn.castlerButtonColor(
        *ngIf='partyId && !editMode && !readOnly',
        (click)='toggleEditMode()'
    ) Edit

    .flex-container.flex-row(*ngIf='loadingData$ | async')
        .align-self-center Please wait...