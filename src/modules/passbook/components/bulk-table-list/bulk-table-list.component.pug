div
    div(*ngIf='errors.length > 0')
        sbpro-alert(classes='alert-danger', [dismissable]='true', (click)='errors = []')
            | {{ errors[0] }}
    form
        .d-flex.mb-2
            input#search-box.mt-1.form-control.w-100.mr-2(
                type='text',
                name='s',
                placement='top',
                autocomplete='off',
                (input) = 'Search($event)',
                [(ngModel)] = 'searchTerm',
                ngbPopover='Search by Batch ID, Payment ID, Beneficiary Name',
                placeholder='Search by Batch ID, Payment ID, Beneficiary Name',
            )
            input#date-from.mt-1.form-control.w-25.mr-2(
                type='text',
                placeholder='Start Date',
                name='dateFrom',
                ngbDatepicker,
                outsideDays='hidden',
                autocomplete='off',
                #dateFrom='ngbDatepicker',
                (click)='dateFrom.toggle()',
                [(ngModel)] = 'startDate',
                (ngModelChange)="startDateChange()",
                [maxDate]="maxDate"
            )
            input#date-to.mt-1.form-control.w-25.mr-2(
                type='text',
                placeholder='End Date',
                name='dateTo',
                ngbDatepicker,
                outsideDays='hidden',
                autocomplete='off',
                #dateTo='ngbDatepicker',
                (click)='dateTo.toggle()',
                [(ngModel)] = 'endDate',
                (ngModelChange)="endDateChange()",
                [maxDate]='maxDate',
            )
            select.mt-1.form-control.w-25.mr-2(
                *ngIf='isAdmin && !isTrustee',
                name='bank',
                [(ngModel)]='bank'
            )
                option(value='') Select Bank
                option(value='icici') ICICI
                option(value='rbl') RBL
                option(value='yes_bank') YES BANK
                option(value='idfc') IDFC
                option(value='ibl') IndusInd
                option(value='hdfc') HDFC
            select#statusList.mt-1.form-control.w-25.mr-2(
                name='status',
                [(ngModel)]='selectedStatus'
            )
                option(value='') Status
                option(*ngFor='let st of statusListSearch', [ngValue]='st') {{ st }}
            button.btn.ml-2.ws-nowrap.mt-1.mb-1(
                class='castlerButtonColor',
                type='submit',
                (click)='filterData()'
            )
                fa-icon.d-flex.flex-row.align-items-center([icon]='["fas", "search"]')
            button.btn.btn-link.mt-1.mb-1.mr-2(
                type='button',
                class='logoColor',
                (click)='clearSearch()'
            )
                | Clear
            .justify-content-end(*ngIf='!connectedBanking')
                a.btn.mt-1.mb-1.btn-success.ws-nowrap.btn-icon(
                    style='color: white',
                    type='button',
                    target='_blank',
                    [href]='downloadLink'
                )
                    fa-icon.d-flex.flex-row.align-items-center(
                        [icon]='["fas", "arrow-down"]'
                    )
        .d-flex.mb-2(*ngIf='data.length > 0 ')
            .flex-row
                small.mb-2.mt-2 Showing {{  (page - 1)  * 10 + 1 }} to {{ (page - 1)  * 10 +  (data)?.length  }} of {{total$}}

    .table-responsive.pp-table-container.table-responsive-sm
        table.table
            thead
                tr
                    th(scope='col', sbSortable='event', *ngIf='isAdmin')
                        span.ws-nowrap Business Name
                    th(scope='col', sbSortable='event')
                        span.ws-nowrap Batch ID
                    th(scope='col', sbSortable='time')
                        span.ws-nowrap Batch Name
                    th(scope='col', sbSortable='time', *ngIf='connectedBanking')
                        span.ws-nowrap Bank Account
                    th(scope='col', sbSortable='time', *ngIf='!connectedBanking')
                        span.ws-nowrap Escrow ID
                    th(scope='col', sbSortable='time', style='width: 100px')
                        span.ws-nowrap Date
                    th(scope='col', sbSortable='time')
                        span.ws-nowrap No of Transfers
                    th(scope='col', sbSortable='time')
                        span.ws-nowrap Total Amount
                    th(scope='col', sbSortable='time')
                        span.ws-nowrap Status
                    th(scope='col', sbSortable='time')
                        span.ws-nowrap Transfer List
                    th(scope='col', sbSortable='time', *ngIf='(isAdmin && !readOnly) || isTesting')
                        span.ws-nowrap Action
            tbody
                tr(*ngIf='isLoading')
                    .spinner-border.text-primary(role='status')
