ng-template(#content='', let-modal='')
    .modal-header.no-border
        h5#exampleModalLabel.modal-title(class= 'logoColor') Payees Linked
        button.close(type='button', (click)="modal.dismiss('Cross click')" , aria-label='Close', class = 'castlerButtonColor1')
            span(aria-hidden='true') &times;
    .modal-body
        .table-responsive.pp-table-container
            table.table
                thead
                    tr
                        th(scope='col', sbSortable='event')
                            span.ws-nowrap Beneficiary Name
                        th(scope='col', sbSortable='time')
                            span.ws-nowrap Beneficiary Account number
                        th(scope='col', sbSortable='time')
                            span.ws-nowrap IFSC code
                        th(scope='col', sbSortable='time')
                            span.ws-nowrap Amount
                        th(scope='col', sbSortable='time')
                            span.ws-nowrap Description / Purpose
                        th(scope='col', sbSortable='time')
                            span.ws-nowrap Bank Name
                tbody(*ngIf='payeeOfSingleTransfer.length == 0')
                    tr
                        td No Entries Found
                tbody
                    tr(
                        *ngFor='let data of payeeOfSingleTransfer | slice: (transferPage - 1) * transferPageSize:transferPage * transferPageSize'
                    )
                        td
                            ngb-highlight.ws-nowrap([result]='data.beneficiaryName')
                        td
                            ngb-highlight([result]='data.beneficiaryAccNumber')
                        td
                            ngb-highlight([result]='data.beneficiaryIFSC')
                        td
                            ngb-highlight([result]='toINR(data.amount)')
                        td
                            ngb-highlight([result]='data.purpose')
                        td
                            ngb-highlight([result]='data.beneficiaryBankName')
        .d-flex.justify-content-between.p-2
            ngb-pagination(
                [collectionSize]='transfersTotal$',
                [maxSize]='5',
                [(page)]='transferPage',
                [pageSize]='transferPageSize',
                [rotate]='true',
                [ellipses]='false',
                (pageChange)='loadPage($event)',
                [boundaryLinks]='true'
            )
    .modal-footer
        button.btn(type='button', (click)="modal.close('Save click')", class = 'castlerButtonColor') Close

ng-template(#statusMap)
  .modal-header(class='logoColor') Transfer Status
  .isDataLoading(*ngIf="isLoadingAuthorization")
    .spinner-border.text-primary(role='status')
        span.sr-only Loading...

  .modal-body(*ngIf='!oldMap && !isLoadingAuthorization')
    .container.mt-5.mb-5
      .row
        .col
          h4 Fund Transfer
          ul.timeline
            li.green
              h3
                b Initiated
              p(*ngIf='selectedTransfer.createdByEmail')
                i {{selectedTransfer.createdByEmail}}  
              i {{ selectedTransfer.createdAt | date:'medium'}}
            div.p-0.m-0(*ngFor='let auth of authorizers | keyvalue')
              div.p-0.m-0(*ngFor='let level of authorizers[auth.key] | keyvalue')
                div.p-0.m-0(*ngFor='let authorizer of authorizers[auth.key][level.key]["authorizers"]')
                  li(*ngIf='authorizer.verified', [ngClass]='!authorizer.verified? "white" : authorizer.verified && !authorizer.data.approved ? "red" : "green"')
                    h3
                      span(*ngIf='authorizer.verified && authorizer.data.approved')
                        p
                          b Approved
                          small(*ngIf='auth.key !== "4trustee" && auth.key !== "3admin"') (Level {{authorizer.data.level}} {{authorizer.data.type.split(' ')[0]}})
                      span(*ngIf='authorizer.verified && !authorizer.data.approved')
                        p
                          b Rejected
                          small(*ngIf='auth.key !== "4trustee" && auth.key !== "3admin"') (Level {{authorizer.data.level}} {{authorizer.data.type.split(' ')[0]}})
                    i(*ngIf='authorizer.email === selectedTransfer.createdBy') 
                      b(style="font-size:  0.9rem;") Auto Approved
                    p
                      i {{authorizer.email}}
                    i {{ authorizer.verifiedAt | date:'medium' }}
                li.white(*ngIf='selectedTransfer.status !== "Completed" && selectedTransfer.status !== "Failed" && !authorizers[auth.key][level.key]["isApproved"] && !hasRejectedAuthorizer(auth.key, level.key)')                  
                  h3
                    p(*ngIf='!auth.verified')
                      b Pending for approval
                  p
                    i(*ngIf='auth.key !== "4trustee" && auth.key !== "3admin"') Level {{level.key}} {{ authorizers[auth.key][level.key].type }} ({{authorizers[auth.key][level.key].minApprovalsNeeded}})
                    i(*ngIf='auth.key === "4trustee"', style="width: fit-content; max-width: 20ch; overflow-wrap: break-word;") {{ trusteeEmails }}
                    i(*ngIf='auth.key === "3admin"')  {{ authorizers[auth.key][level.key]["authorizers"][0].email }}
            li.green(*ngIf='selectedTransfer.status !== "Failed" &&  selectedTransfer.status ==="Sent for Processing" || selectedTransfer.status ==="failed" || selectedTransfer.status === "success"')
              h3
                b Sent for processing
              i {{ selectedTransfer.updatedAt | date:'medium'}}
            li(*ngIf='selectedTransfer.status ==="Failed" || selectedTransfer.status === "Success"', [ngClass]='selectedTransfer.status ==="Failed" ? "red" : "green"')
              h3
                b {{selectedTransfer.status}}
              i {{ selectedTransfer.updatedAt | date:'medium'}}

  .modal-body(*ngIf='oldMap && !isLoadingAuthorization')
    div(*ngIf='selectedTransfer.authorization.length === 0')
      p No approvals found for this transaction.
    div(*ngIf='selectedTransfer.authorization.length > 0')
      .container.mt-5.mb-5
        .row
          .col
            h4 Fund Transfer
            ul.timeline
              li.green
                h3
                  b Initiated
                i {{ selectedTransfer.createdAt | date:'medium'}}
              li(*ngFor='let auth of selectedTransfer.authorization', [ngClass]='!auth.verified? "white" : auth.verified && !auth.data.approved ? "red" : "green"')
                h3
                  p(*ngIf='!auth.verified')
                    b Pending for approval
                  span(*ngIf='auth.verified && auth.data.approved')
                    p
                      b Approved
                  span(*ngIf='auth.verified && !auth.data.approved')
                    p
                      b Rejected
                p
                  i {{auth.email}}
                i {{ auth.verifiedAt | date:'medium' }}
              li.green(*ngIf='selectedTransfer.status ==="Sent for Processing" || selectedTransfer.status ==="failed" || selectedTransfer.status === "success"')
                h3
                  b Sent for processing
                i {{ selectedTransfer.updatedAt | date:'medium'}}
              li(*ngIf='selectedTransfer.status ==="Failed" || selectedTransfer.status === "Success"',[ngClass]='selectedTransfer.status ==="Failed" ? "red" : "green"')
                h3
                  b {{selectedTransfer.status}}
                i {{ selectedTransfer.updatedAt | date:'medium'}}
  .modal-footer
    button.btn.btn-sm((click)='closeModal()', class='castlerButtonColor', style='box-shadow: none') Close
