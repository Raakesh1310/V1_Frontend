// hiding card body
//sbpro-card([headerActions]='true')
//  .card-header(class='logoColor')
//    span Transfer List
//
//  .card-body
div
    div(*ngIf='errors.length > 0')
        sbpro-alert(classes='alert-danger', [dismissable]='true', (click)='errors = []')
            | {{ errors[0] }}
    form
      .d-flex.mb-2
        input#search-box.mt-1.form-control.w-100.mr-2(
          *ngIf = '!connectedBanking'
          type='text',
          name='s',
          placement='top',
          autocomplete='off',
          ngbPopover='Search by Escrow ID, Payment ID, Beneficiary Name',
          placeholder='Search by Escrow ID, Payment ID, Beneficiary Name',
          [(ngModel)]='passbookService.searchTerm'
        )
        input#search-box.mt-1.form-control.w-100.mr-2(
          *ngIf = 'connectedBanking'
          type='text',
          name='s',
          placement='top',
          autocomplete='off',
          ngbPopover='Search by Bank Account, Payment ID, Beneficiary Name',
          placeholder='Search by Bank Account, Payment ID, Beneficiary Name',
          [(ngModel)]='passbookService.searchTerm'
        )
        input#date-from.mt-1.form-control.w-25.mr-2(
          type='text',
          placeholder='Start Date',
          name='dateFrom',
          ngbDatepicker,
          outsideDays='hidden',
          autocomplete='off',
          #dateFrom='ngbDatepicker',
          (click)='dateFrom.toggle()',
          [(ngModel)]='passbookService.dateFrom',
          [minDate]='passbookService.dateFromMin',
          [maxDate]='passbookService.dateFromMax'
        )
        input#date-to.mt-1.form-control.w-25.mr-2(
          type='text',
          placeholder='End Date',
          name='dateTo',
          ngbDatepicker,
          outsideDays='hidden',
          autocomplete='off',
          #dateTo='ngbDatepicker',
          (click)='dateTo.toggle()',
          [(ngModel)]='passbookService.dateTo',
          [minDate]='passbookService.dateToMin',
          [maxDate]='passbookService.dateToMax'
        )
        select#statusList.mt-1.form-control.w-25.mr-2(
            name='status',
            [(ngModel)]='passbookService.status'
        )
            option(value='') Status
            option(*ngFor='let st of statusList', [ngValue]='st') {{ st }}

        button.btn.ml-2.ws-nowrap.mt-1.mb-1(
          class='castlerButtonColor',
          type='submit',
          (click)='submitSearchForm()'
        )
          fa-icon.d-flex.flex-row.align-items-center([icon]='["fas", "search"]')
        button.btn.btn-link.mt-1.mb-1.mr-2(
          type='button',
          class='logoColor',
          (click)='clearSearchForm()'
        )
          | Clear
        .justify-content-end 
          a.btn.mt-1.mb-1.btn-success.ws-nowrap.btn-icon(
            type='button',
            target='_blank',
            [href]='passbookService.reportDownloadLink$ | async'
          )
            fa-icon.d-flex.flex-row.align-items-center(
              [icon]='["fas", "arrow-down"]'
            )
      .d-flex.mb-2(*ngIf='(transfers$ | async)?.length > 0')
          .flex-row
            small.mb-2.mt-2 Showing {{  (passbookService.page - 1)  * 10 + 1 }} to {{ (passbookService.page - 1)  * 10 +  (transfers$ | async)?.length  }} of {{total$ | async}}
          
          

    .table-responsive.pp-table-container.table-responsive-sm
      table.table
        thead
          tr
            th(scope='col', sbSortable='event', (sort)='onSort($event)')
              span.ws-nowrap Payment ID
              sb-sort-icon(
                *ngIf='sortedColumn === "event"',
                [direction]='sortedDirection'
              )
            th(scope='col', sbSortable='time', (sort)='onSort($event)')
              span.ws-nowrap Request Date
              sb-sort-icon(
                *ngIf='sortedColumn === "time"',
                [direction]='sortedDirection'
              )
            th(scope='col', sbSortable='time', (sort)='onSort($event)')
              span.ws-nowrap Last Updation Date
              sb-sort-icon(
                *ngIf='sortedColumn === "time"',
                [direction]='sortedDirection'
              )
            th(*ngIf='connectedBanking', scope='col', sbSortable='time', (sort)='onSort($event)')
              span.ws-nowrap From Bank Account
              sb-sort-icon(
                *ngIf='sortedColumn === "time"',
                [direction]='sortedDirection'
              )
            th(*ngIf='!connectedBanking', scope='col', sbSortable='time', (sort)='onSort($event)')
              span.ws-nowrap From Escrow ID
              sb-sort-icon(
                *ngIf='sortedColumn === "time"',
                [direction]='sortedDirection'
              )
            th(scope='col', sbSortable='time', (sort)='onSort($event)')
              span.ws-nowrap Beneficiary Name
              sb-sort-icon(
                *ngIf='sortedColumn === "time"',
                [direction]='sortedDirection'
              )
            th(scope='col', sbSortable='time', (sort)='onSort($event)')
              span.ws-nowrap Beneficiary Bank
              sb-sort-icon(
                *ngIf='sortedColumn === "time"',
                [direction]='sortedDirection'
              )
            th(scope='col', sbSortable='time', (sort)='onSort($event)')
              span.ws-nowrap Beneficiary A/c 
              sb-sort-icon(
                *ngIf='sortedColumn === "time"',
                [direction]='sortedDirection'
              )
            th(scope='col', sbSortable='time', (sort)='onSort($event)')
              span UTR
              sb-sort-icon(
                *ngIf='sortedColumn === "time"',
                [direction]='sortedDirection'
              )
            th(scope='col', sbSortable='time', (sort)='onSort($event)')
              span Amount
              sb-sort-icon(
                *ngIf='sortedColumn === "time"',
                [direction]='sortedDirection'
              )
            th(scope='col', sbSortable='time', (sort)='onSort($event)')
              span Status
              sb-sort-icon(
                *ngIf='sortedColumn === "time"',
                [direction]='sortedDirection'
              )
            th(scope='col', sbSortable='time', (sort)='onSort($event)', *ngIf='isTesting')
              span Action
              sb-sort-icon(
                *ngIf='sortedColumn === "time"',
                [direction]='sortedDirection'
              )
        tbody(*ngIf='(transfers$ | async)?.length == 0')
          tr
            td(
              *ngIf='!(passbookService.loading$ | async) && (transfers$ | async)?.length == 0'
            ) No Entries Found
            td.spinner(*ngIf='passbookService.loading$ | async')
              .spinner-border.text-primary(role='status')
                span.sr-only Loading...

        tbody
          tr(*ngFor='let transfer of transfers$ | async; index as i')
            td
              ngb-highlight.myanchor(
                [result]='transfer.transferId + " "',
                [term]='passbookService.searchTerm',
                class='tableClickEntryColor',
                (click)='showDetails(transfer.transferId)'
              )
            td
              ngb-highlight.ws-nowrap(
                [result]='transfer.createdAt | date: "d MMM yyyy" || "--"',
                [term]='passbookService.searchTerm'
              )
            td
              ngb-highlight.ws-nowrap(
                [result]='transfer.updatedAt | date: "d MMM yyyy" || "--"',
                [term]='passbookService.searchTerm'
              )
            td(*ngIf='connectedBanking')
              ngb-highlight(
                [result]='transfer.bankAccountNumber',
                [term]='passbookService.searchTerm'
              )
            td(*ngIf='!connectedBanking')
              ngb-highlight(
                [result]='transfer.accountId',
                [term]='passbookService.searchTerm'
              )
            td
              ngb-highlight(
                [result]='transfer.beneficiaryName',
                [term]='passbookService.searchTerm'
              )
            td
              ngb-highlight(
                [result]='transfer.beneficiaryBankName || "--"',
                [term]='passbookService.searchTerm'
              )
            td
              ngb-highlight(
                [result]='transfer.beneficiaryAccNumber || transfer.vpa || "--"',
                [term]='passbookService.searchTerm'
              )
            td
              span(
                  *ngIf='!transfer.utr && !(enableEdit && enableEditIndex == i)'
              ) --
              ngb-highlight(
                  [result]='transfer.utr',
                  [term]='transferService.searchTerm',
                  *ngIf='!enableEdit'
              )
              input#utr.min-w-150px.mt-1.form-control.form-control-sm.w-100(
                  type='text',
                  [(ngModel)]='transfer.utr',
                  name='utr',
                  *ngIf='enableEdit && enableEditIndex == i'
              )
            td
              ngb-highlight(
                [result]= 'toINR(transfer.amount.toFixed(2))',
                [term]='passbookService.searchTerm'
              )
            td(*ngIf = 'transfer.status == "Pending for Authorization"',)
              ngb-highlight.myanchor(
                style='color: #F5A500; font-weight: bold',
                [result]='transfer.status',
                (click)='selectedTransfer = transfer; openMap(statusMap)',
                *ngIf='!enableEdit'
              )
              select#statusListInline.min-w-150px.mt-1.form-control.form-control-sm.w-100(
                *ngIf='enableEdit && enableEditIndex == i',
                name='status',
                [(ngModel)]='transfer.status'
              )
                option(value='') Select Status
                option(*ngFor='let st of statusList', [ngValue]='st') {{ st }}
            td(*ngIf = 'transfer.status == "Sent for Processing"')
              ngb-highlight.myanchor(
                style='color: #329ca8; font-weight: bold',
                [result]='transfer.status',
                (click)='selectedTransfer = transfer; openMap(statusMap)',
                *ngIf='!enableEdit'
              )
              select#statusListInline.min-w-150px.mt-1.form-control.form-control-sm.w-100(
                *ngIf='enableEdit && enableEditIndex == i',
                name='status',
                [(ngModel)]='transfer.status'
              )
                option(value='') Select Status
                option(*ngFor='let st of statusList', [ngValue]='st') {{ st }}
            td(*ngIf = 'transfer.status == "Failed"')
              ngb-highlight.myanchor(
                style='color: #FF0000; font-weight: bold',
                [result]='transfer.status',
                (click)='selectedTransfer = transfer; openMap(statusMap)',
                *ngIf='!enableEdit'
              )
              select#statusListInline.min-w-150px.mt-1.form-control.form-control-sm.w-100(
                *ngIf='enableEdit && enableEditIndex == i',
                name='status',
                [(ngModel)]='transfer.status'
              )
                option(value='') Select Status
                option(*ngFor='let st of statusList', [ngValue]='st') {{ st }}
            td(*ngIf = 'transfer.status == "Success"')
              ngb-highlight.myanchor(
                style='color: #18B81F; font-weight: bold',
                [result]='transfer.status',
                (click)='selectedTransfer = transfer; openMap(statusMap)',
                *ngIf='!enableEdit'
              )
              select#statusListInline.min-w-150px.mt-1.form-control.form-control-sm.w-100(
                *ngIf='enableEdit && enableEditIndex == i',
                name='status',
                [(ngModel)]='transfer.status'
              )
                option(value='') Select Status
                option(*ngFor='let st of statusList', [ngValue]='st') {{ st }}
            td(*ngIf = 'transfer.status == "success"')
              ngb-highlight.myanchor(
                style='color: #18B81F; font-weight: bold',
                [result]='transfer.status',
                (click)='selectedTransfer = transfer; openMap(statusMap)',
                *ngIf='!enableEdit'
              )
            td(*ngIf = 'transfer.status == "failed"')
              ngb-highlight.myanchor(
                style='color: #FF0000; font-weight: bold',
                [result]='transfer.status',
                (click)='selectedTransfer = transfer; openMap(statusMap)',
                *ngIf='!enableEdit'
              )
            td(*ngIf='isTesting')
              button.btn.btn-success.btn-xs.mr-2.font-weight-700.ws-nowrap(
                  *ngIf='enableEdit && enableEditIndex == i',
                  (click)='updateRow(transfer)'
              ) Save
              button.btn.btn-danger.btn-xs.mr-2.font-weight-700.ws-nowrap(
                  *ngIf='enableEdit && enableEditIndex == i',
                  (click)='enableEdit = false'
              ) Cancel
              button.btn.btn-danger.btn-xs.mr-2.font-weight-700.ws-nowrap(
                  *ngIf='!enableEdit && (transfer.status === "Pending" || transfer.status === "pending" || transfer.status === "" || transfer.status === "Pending for Authorization" || transfer.status === "Sent for Processing")',
                  (click)='enableEditMethod($event, i)'
              ) Edit

    .d-flex.justify-content-between.p-2
      ngb-pagination(
        [collectionSize]='total$ | async',
        [(page)]='passbookService.page',
        [maxSize]='5',
        [rotate]='true',
        [ellipses]='false',
        [boundaryLinks]='true'
      )

ng-template(#statusMap)
  .modal-header(class='logoColor') Transfer Status
  .modal-body(*ngIf='!oldMap')
    .container.mt-5.mb-5
      .row
        .col
          h4 Fund Transfer
          ul.timeline
            li.green
              h3
                b Initiated
              p 
                i {{ selectedTransfer.createdBy }}
              i {{ selectedTransfer.createdAt | date:'medium'}}
            div.p-0.m-0(*ngFor='let auth of authorizers | keyvalue')
              div.p-0.m-0(*ngFor='let level of authorizers[auth.key] | keyvalue')
                div.p-0.m-0(*ngFor='let authorizer of authorizers[auth.key][level.key]["authorizers"]')
                  li(*ngIf='authorizer.verified', [ngClass]='!authorizer.verified? "white" : authorizer.verified && !authorizer.data.approved ? "red" : "green"')
                    h3
                      span(*ngIf='authorizer.verified && authorizer.data.approved')
                        p
                          b Approved
                          small(*ngIf='auth.key !== "4trustee" && auth.key !== "3admin"') (Level {{authorizer.data.level}} {{authorizer.data.type.split(' ')[0]}})
                      span(*ngIf='authorizer.verified && !authorizer.data.approved')
                        p
                          b Rejected
                          small(*ngIf='auth.key !== "4trustee" && auth.key !== "3admin"') (Level {{authorizer.data.level}} {{authorizer.data.type.split(' ')[0]}})
                    i(*ngIf='authorizer.email === selectedTransfer.createdBy')
                      b(style="font-size:  0.9rem;") Auto Approved
                    p
                      i {{authorizer.email}}
                    p 
                      i {{ authorizer.verifiedAt | date:'medium' }}
                    
                li.white(*ngIf='selectedTransfer.status !== "Failed" && !authorizers[auth.key][level.key]["isApproved"]')
                  h3
                    p(*ngIf='!auth.verified')
                      b Pending for approval
                  p
                    i(*ngIf='auth.key !== "4trustee" && auth.key !== "3admin"') Level {{level.key}} {{ authorizers[auth.key][level.key].type }} ({{authorizers[auth.key][level.key].minApprovalsNeeded}})
                    i(*ngIf='auth.key === "4trustee"', style="width: fit-content; max-width: 20ch; overflow-wrap: break-word;") {{ trusteeEmails }}
                    i(*ngIf='auth.key === "3admin"')  {{ authorizers[auth.key][level.key]["authorizers"][0].email }}
            li.green(*ngIf='selectedTransfer.status !== "Failed" &&  selectedTransfer.status ==="Sent for Processing" || selectedTransfer.status ==="failed" || selectedTransfer.status === "success"')
              h3
                b Sent for processing
              i {{ selectedTransfer.updatedAt | date:'medium'}}
            li(*ngIf='selectedTransfer.status ==="Failed" || selectedTransfer.status === "Success"', [ngClass]='selectedTransfer.status ==="Failed" ? "red" : "green"')
              h3
                b {{selectedTransfer.status}}
              i {{ selectedTransfer.updatedAt | date:'medium'}}

  .modal-body(*ngIf='oldMap')
    div(*ngIf='selectedTransfer.authorization.length === 0')
      p No approvals found for this transaction.
    div(*ngIf='selectedTransfer.authorization.length > 0')
      .container.mt-5.mb-5
        .row
          .col
            h4 Fund Transfer
            ul.timeline
              li.green
                h3
                  b Initiated
                i {{ selectedTransfer.createdAt | date:'medium'}}
              li(*ngFor='let auth of selectedTransfer.authorization', [ngClass]='!auth.verified? "white" : auth.verified && !auth.data.approved ? "red" : "green"')
                h3
                  p(*ngIf='!auth.verified')
                    b Pending for approval
                  span(*ngIf='auth.verified && auth.data.approved')
                    p
                      b Approved
                  span(*ngIf='auth.verified && !auth.data.approved')
                    p
                      b Rejected
                p
                  i {{auth.email}}
                i {{ auth.verifiedAt | date:'medium' }}
              li.green(*ngIf='selectedTransfer.status ==="Sent for Processing" || selectedTransfer.status ==="failed" || selectedTransfer.status === "success"')
                h3
                  b Sent for processing
                i {{ selectedTransfer.updatedAt | date:'medium'}}
              li(*ngIf='selectedTransfer.status ==="Failed" || selectedTransfer.status === "Success"',[ngClass]='selectedTransfer.status ==="Failed" ? "red" : "green"')
                h3
                  b {{selectedTransfer.status}}
                i {{ selectedTransfer.updatedAt | date:'medium'}}

  .modal-footer
    button.btn.btn-sm((click)='closeModal()', class='castlerButtonColor', style='box-shadow: none') Close

ng-template(#approved)
