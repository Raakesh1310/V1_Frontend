div(*ngIf='isOwner')
    sbpro-alert(classes='alert-info', *ngFor='let i of invites')
        span.click.blue((click)='acceptInvite(i.merchantUserId)') Accept &nbsp;&nbsp;
        span.click.red((click)='cancelInvite(i.merchantUserId)') Reject
        | &nbsp;&nbsp;&nbsp; You have an Invitation from "{{ i.merchant.title }}" for the role of "{{ i.role[0] }}"

div(*ngIf='!isMerchantVerified')
    sbpro-alert(classes='alert-info')
        | Activate your account - Complete your KYC to start using our products.
        | Fill the KYC form&nbsp;
        u.blue.click((click)='redirectKYC()') here

ng-template(#all)
    sbpro-dashboard-charts(
        [bankNames]='banks',
        [cb] = 'cb'
    )
sbpro-card-navigation(
    *ngIf='!isAdmin && !connectedBanking',
    sbproTocItem='Tabs',
    [navNames]='navNames',
    [templates]='templateRefs',
    navType = 'pill'
)
    ng-template(#all)
        sbpro-dashboard-charts(
            [bankNames]='banks',
            [cb] = 'cb'
        )
    ng-template(#icici)
        sbpro-dashboard-charts([bankNames]='["icici"]',[cb] = 'cb')
    ng-template(#rbl)
        sbpro-dashboard-charts([bankNames]='["rbl"]',[cb] = 'cb')
    ng-template(#yes)
        sbpro-dashboard-charts([bankNames]='["yes_bank"]',[cb] = 'cb')
    ng-template(#idfc)
        sbpro-dashboard-charts([bankNames]='["idfc"]',[cb] = 'cb')
    ng-template(#ibl)
        sbpro-dashboard-charts([bankNames]='["ibl"]',[cb] = 'cb')
    ng-template(#hdfc)
        sbpro-dashboard-charts([bankNames]='["hdfc"]',[cb] = 'cb')
    ng-template(#dbs)
        sbpro-dashboard-charts([bankNames]='["dbs"]',[cb] = 'cb')
    ng-template(#axis)
        sbpro-dashboard-charts([bankNames]='["axis"]',[cb] = 'cb')

