    .card.border-top-0.border-bottom-0.border-right-0.border-left-lg.h-100(
      style='border-left-color: #fa8602',
      *ngIf='!loadingMerchantCount'
    )
      .card-body(style='background: #FFFBF4;')
        .d-flex.align-items-center
          .flex-grow-1
            .small.font-weight-bold.mb-1(style='color: #fa8602;font-size: 16px') No. of Merchants onboarded
            .p(style='color: #fa8602;font-weight: bold;font-size: 26px;') {{ merchantCount }}

  .col-xl-4.col-md-6.mb-4(*ngIf='isAdmin')
    .dashboard-card.pt-3.pb-3.pl-4.pr-4(*ngIf='loadingTotalBilledAmount')
