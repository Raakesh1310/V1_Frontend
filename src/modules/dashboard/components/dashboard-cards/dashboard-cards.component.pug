      style='border-left-color: #E41144',
      *ngIf='!loadingTransferAmount'
    )
      .card-body(*ngIf = 'allBanks', style='background: #FFFBF4;')
        .d-flex.align-items-center
          .flex-grow-1
            .small.font-weight-bold.mb-1(style='color: #FF5F6D;font-size: 16px') {{connectedBanking ? "Total Amount of Transfers" : "Total Amount of Transfers"}}
            .p(style='color: #FF5F6D;font-weight: bold;font-size: 26px;') {{ transferAmount }}
      .card-body(*ngIf = '!allBanks', style='background: #FFFBF4;')
        .d-flex.align-items-center
          .flex-grow-1
            .small.font-weight-bold.mb-1(style='color: #FF5F6D;font-size: 16px') {{connectedBanking ? "Amount of Transfers" : "Amount of Outward Transfers"}}
            .p(style='color: #FF5F6D;font-weight: bold;font-size: 26px;') {{ transferAmount }}
  .col-xl-4.col-md-6.mb-4(*ngIf='isAdmin')
    .dashboard-card.pt-3.pb-3.pl-4.pr-4(*ngIf='loadingAverageTransferAmount')
      ngx-skeleton-loader(count='1', [theme]='{ height: "20px", width: "100px" }')
      ngx-skeleton-loader(count='1', [theme]='{ height: "20px" }')
    .card.border-top-0.border-bottom-0.border-right-0.border-left-lg.h-100(
      style='border-left-color: #E41144',
      *ngIf='!loadingAverageTransferAmount'
    )
      .card-body(style='background: #FFFBF4;')
        .d-flex.align-items-center
          .flex-grow-1
            .small.font-weight-bold.mb-1(style='color: #FF5F6D;font-size: 16px') Avg daily transfers
            .p(style='color: #FF5F6D;font-weight: bold;font-size: 26px;') {{ averageTransferAmount }}

  .col-xl-4.col-md-6.mb-4(*ngIf='isAdmin')
    .dashboard-card.pt-3.pb-3.pl-4.pr-4(*ngIf='loadingMerchantCount')
      ngx-skeleton-loader(count='1', [theme]='{ height: "20px", width: "100px" }')
