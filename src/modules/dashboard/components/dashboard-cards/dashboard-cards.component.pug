.row
  .col-xl-4.col-md-6.mb-4
    .dashboard-card.pt-3.pb-3.pl-4.pr-4(*ngIf='loadingNumTransactions')
      ngx-skeleton-loader(count='1', [theme]='{ height: "20px", width: "100px" }')
      ngx-skeleton-loader(count='1', [theme]='{ height: "20px" }')
    .card.border-top-0.border-bottom-0.border-right-0.border-left-lg.h-100(
      style='border-left-color: #09B261',
      *ngIf='!loadingNumTransactions'
    )
      .card-body(*ngIf = 'allBanks',style='background: #FFFBF4;')
        .d-flex.align-items-center
          .flex-grow-1
            .small.font-weight-bold.mb-1(style='color: #09B261;font-size: 16px') {{connectedBanking ? "Total Number of Deposits" : "Total Number of Deposits" }}
            .p(style='color: #09B261;font-weight: bold;font-size: 26px;') {{ numTransactions }}
      .card-body(*ngIf = '!allBanks',style='background: #FFFBF4;')
        .d-flex.align-items-center
          .flex-grow-1
            .small.font-weight-bold.mb-1(style='color: #09B261;font-size: 16px') {{connectedBanking ? "Number of Deposits" : "Number of Inward Deposits" }}
            .p(style='color: #09B261;font-weight: bold;font-size: 26px;') {{ numTransactions }}

  .col-xl-4.col-md-6.mb-4
    .dashboard-card.pt-3.pb-3.pl-4.pr-4(*ngIf='loadingTransactionAmount')
      ngx-skeleton-loader(count='1', [theme]='{ height: "20px", width: "100px" }')
      ngx-skeleton-loader(count='1', [theme]='{ height: "20px" }')
    .card.border-top-0.border-bottom-0.border-right-0.border-left-lg.h-100(
      style='border-left-color: #09B261',
      *ngIf='!loadingTransactionAmount'
    )
      .card-body(*ngIf = 'allBanks',style='background: #FFFBF4;')
        .d-flex.align-items-center
          .flex-grow-1
            .small.font-weight-bold.mb-1(style='color: #09B261;font-size: 16px') {{connectedBanking ? "Total Amount of Deposits" :"Total Amount of Deposits"}}
            .p(style='color: #09B261;font-weight: bold;font-size: 26px;') {{ transactionAmount }}
      .card-body(*ngIf = '!allBanks',style='background: #FFFBF4;')
        .d-flex.align-items-center
          .flex-grow-1
            .small.font-weight-bold.mb-1(style='color: #09B261;font-size: 16px') {{connectedBanking ? "Amount of Deposits" :"Amount of Inward Deposits"}}
            .p(style='color: #09B261;font-weight: bold;font-size: 26px;') {{ transactionAmount }}
  .col-xl-4.col-md-6.mb-4(*ngIf='isAdmin')
    .dashboard-card.pt-3.pb-3.pl-4.pr-4(*ngIf='loadingTransactionAmount')
      ngx-skeleton-loader(count='1', [theme]='{ height: "20px", width: "100px" }')
      ngx-skeleton-loader(count='1', [theme]='{ height: "20px" }')
    .card.border-top-0.border-bottom-0.border-right-0.border-left-lg.h-100(
      style='border-left-color: #09B261',
      *ngIf='!loadingTransactionAmount'
    )
      .card-body(style='background: #FFFBF4;')
        .d-flex.align-items-center
          .flex-grow-1
            .small.font-weight-bold.mb-1(style='color: #09B261;font-size: 16px') Avg daily deposits
            .p(style='color: #09B261;font-weight: bold;font-size: 26px;') {{ averageTransactionAmount }}

  .col-xl-4.col-md-6.mb-4
    .dashboard-card.pt-3.pb-3.pl-4.pr-4(*ngIf='loadingNumTransfers')
      ngx-skeleton-loader(count='1', [theme]='{ height: "20px", width: "100px" }')
      ngx-skeleton-loader(count='1', [theme]='{ height: "20px" }')
    .card.border-top-0.border-bottom-0.border-right-0.border-left-lg.h-100(
      style='border-left-color: #E41144',
      *ngIf='!loadingNumTransfers'
    )
      .card-body(*ngIf = 'allBanks', style='background: #FFFBF4;')
        .d-flex.align-items-center
          .flex-grow-1
            .small.font-weight-bold.mb-1(style='color: #FF5F6D;font-size: 16px') {{connectedBanking ? "Total Number of Transfers" : "Total Number of Transfers"}}
            .p(style='color: #FF5F6D;font-weight: bold;font-size: 26px;') {{ numTransfers }}
      .card-body(*ngIf = '!allBanks', style='background: #FFFBF4;')
        .d-flex.align-items-center
          .flex-grow-1
            .small.font-weight-bold.mb-1(style='color: #FF5F6D;font-size: 16px') {{connectedBanking ? "Number of Transfers" : "Number of Outward Transfers"}}
            .p(style='color: #FF5F6D;font-weight: bold;font-size: 26px;') {{ numTransfers }}
  .col-xl-4.col-md-6.mb-4
    .dashboard-card.pt-3.pb-3.pl-4.pr-4(*ngIf='loadingTransferAmount')
