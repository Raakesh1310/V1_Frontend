sbpro-card 
  .card-header 
    span Detailed Bill

  .card-body
    #printsection
      span(*ngIf='viewMode')
        img.logoImage(
          src='/assets/img/Castler_logo.png',
          width='100',
          height='50'
        )
        br
        br
        center
          h1 
            b {{months[month]}}'{{year}}
        br
        br
        h1 NCOME Tech Solution Pvt Ltd
        span.address 
          h5 F-15D, FIRST FLOOR, DDA SFS FLATS
          h5 SAKET
          h5 NEW DELHI Delhi 110017
          h5 India
          h5 GSTIN 07AAGCN3498L1ZU 
        br
        br
      span(*ngIf='!viewMode')
        h1 {{months[month]}}'{{year}}
        h4 
          b(*ngIf='merchantProfile') {{merchantProfile.businessName}}

        br

      table.table 
        thead 
          tr
            th Date
            th Fee Type
            th Fee Type Description
            th Net Fee Amount ( in Rs )

        tbody
          tr(*ngFor='let bill of billing; index as i')
            td {{bill.createdAt | date: "d MMM yyyy"}}
            td {{ feeTypes[bill.billingType] }}
            td 
              span(*ngIf='bill.accountId') {{ bill.accountId }}
              span(*ngIf='bill.transferId') {{ bill.transferId }}
              span(*ngIf='!bill.accountId && !bill.transferId') --
            //- td
            //-     span(*ngIf='bill.billingType === "virtualEscrow"') 
            //-       span(*ngIf='bill.feeSetting === "one-time"') one-time
            //-       span(*ngIf='bill.feeSetting !== "one-time"') {{ bill.feeAmount }} per VA
            //-     span(*ngIf='bill.billingType === "transaction"') {{ bill.feeAmount }} {{ bill.feeSetting === "percentage" ? "%" : "" }} &nbsp; per Transaction
            td {{ bill.billingAmount }}
          tr 
            th Total
            td 
            td
            th {{ total }}

    span(*ngIf='!viewMode') 
      button.btn.btn-light((click)='goBack()') Back

  .card-footer(*ngIf='viewMode')
    
    button.float-right.btn.btn-primary(
      printSectionId='printsection',
      ngxPrint,
      [useExistingCss]='true'
    ) Print
    span.float-right &nbsp;&nbsp;
    button.float-right.btn.btn-primary((click)='closeModal()') Back to list
