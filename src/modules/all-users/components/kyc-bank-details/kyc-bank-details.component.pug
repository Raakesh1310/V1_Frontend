form.details
  .container-fluid.border.rounded.w-50.float-left.shadow-lg.p-3.mb-5.bg-white.rounded
    .row.pt-2.pl-2
      .col
        h4 Cancelled Cheque
      .col
        .d-flex(*ngIf='isChequePresent')
          p
            a(href="#", (click)='downloadCheque($event)') {{ chequeName }}
            //- a(href='{{ downloadCheque() }}', target='_blank') {{ chequeName }}
          button.btn.btn-light.btn-sm.ml-5(
            *ngIf='editOnly',
            (click)='deleteCheque()'
          )
            i-feather(name='trash-2')
        div(*ngIf='!isChequePresent')
          input(
            #inputFile,
            type='file',
            [accept]='".png, .jpg"',
            (click)='$event.target.value = null',
            (change)='uploadCheque($event)'
          )
          button.btn.btn-light.btn-sm(
            *ngIf='editOnly',
            (click)='openSelectionBox()'
          )
            svg.bi.bi-upload(
              xmlns='http://www.w3.org/2000/svg',
              width='16',
              height='16',
              fill='currentColor',
              viewbox='0 0 16 16'
            )
              path(
                d='M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z'
              )
              path(
                d='M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708l3-3z'
              )

    hr
    .row.p-2
      .col Account Holder Name
      .col {{ accountHolderName }}
    .row.p-2
      .col Bank Account Number
      .col {{ bankAccNumber }}
    .row.p-2
      .col Bank Name
      .col {{ bankName }}
    .row.p-2
      .col IFSC
      .col {{ ifsc }}
    .row.p-2 
      .col Verified on
      .col {{ getDate(bankVerifiedAt) }}
