form.details
  .container-fluid.border.rounded.w-75.float-left.shadow-lg.p-3.mb-5.bg-white.rounded
    .row.p-2
      .col
        h4 Document Type
      .col 
        h4 File(s) Uploaded
      .col
    br
    .row.p-2
      .col PAN
      .col-6
        div(style='cursor: pointer')
          li(*ngFor='let doc of panDocs; let i = index')
            a(href="#", (click)='downloadFile($event, doc.hash, doc?.name)') {{ doc.name }} - {{ toIST(doc.createdAt) }}
      .col
        button.btn.castlerButtonColor.btn-xs((click)='selectPan()') Upload
        input(
          #inputPan,
          type='file',
          accept='.png, .jpg, .pdf',
          (click)='$event.target.value = null',
          (change)='uploadData($event, 1)'
        )
    br
