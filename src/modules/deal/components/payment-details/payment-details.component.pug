ng-template(#claimTemplate)
  sbpro-card([headerActions]='true')
    .card-header 
      | Payment Status
      button.btn.btn-icon.btn-link.btn-sm(
        (click)='claimForm.reset(); claimCheck = false; claimModal.close()'
      )
        i-feather(name='x-circle')
    .card-body 
      div(*ngIf='claimErrors.length > 0')
        sbpro-alert(classes='alert-danger')
          | {{ claimErrors[0] }}
      .form-group
        label Refund Amount
        span.form-control 
          b {{ deal.dealData.securityDeposit - amount }}

      //- .custom-control.custom-checkbox
      //-   input#customCheck1.custom-control-input(
      //-     type='checkbox',
      //-     [(ngModel)]='claimCheck'
      //-   )
      //-   label.custom-control-label(for='customCheck1') Add Claim

      form([formGroup]='claimForm')
        .form-group 
          label Claim Amount
          span.text-danger *
          input.form-control(type='number', formControlName='amount')
        .form-group 
          label Claim Reason
          span.text-danger *
          input.form-control(type='text', formControlName='reason')
    .card-footer 
      button.btn.float-right((click)='openOTP()', class='castlerButtonColor') Next
