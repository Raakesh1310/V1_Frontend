.flex-container
  sbpro-dashboard-head(
    icon="book",
    title="Escrow Details",
    description="Escrow Details."
  )
  .container-fluid.mt-n10.responsiveForm
    sbpro-card-navigation(
      sbproTocItem="Tabs",
      [navNames]="navNames",
      [templates]="isTrustee || isMerchantAuthorizer ? [account, document, payee, authorizer, statements] : isSuperAdminViewer && isSAValid(selectedBank) && sourceAccountValidation ? [account, agreement, document, payee, authorizer, statements, sourceaccount, deposit] : isSuperAdminViewer ? [account, agreement, document, payee, authorizer, statements, deposit] : !isSuperAdminViewer && isSAValid(selectedBank) && sourceAccountValidation ? [account, agreement, document, payee, fd, authorizer, settings, statements, deposit, logs, fees, sourceaccount] : [account, agreement, document, payee, fd, authorizer, settings, statements, deposit, logs, fees]"
    )
      ng-template(#account)
        sbpro-account-detail.card-body.flex-container.align-self-stretch(
          [accountId]="accountId",
          (emitShareUnit)="setDraftShareUnit($event)",
          (emitMerchantId)="setMerchantId($event)",
          (emitSelectedBank)="setSelectedBank($event)",
          (emitAutoTransfer)='toggleAutoTransfer($event)',
          (emitAutoTransferType)='setAutoTransferType($event)',
          (emitScheduledAt)='setScheduledAt($event)',
          [isAdmin]="true",
          [readOnly]="readOnly"
        )
      ng-template(#agreement)
        .card-body.card-body-height-fixed.flex-container.align-self-stretch
          sbpro-account-documents(
            [apiLink]="link",
            [accountId]="accountId",
            [uploadLink]="uploadLink",
            [readOnly]="readOnly"
          )
      ng-template(#document)
        sbpro-account-document-form(
          [accountId]="accountId",
          [viewMode]="readOnly",
          [readOnly]="readOnly"
        )
      ng-template(#payee)
        sbpro-account-payee-form(
          [accountId]="accountId",
          [viewMode]="true",
          [draftPayees]="draftPayees",
          [draftShareUnit]="draftShareUnit",
          (emitDraftPayee)="setdraftPayees($event)",
          (emitUndraftPayee)="unsetdraftPayees($event)",
          [readOnly]="readOnly",
          [merchantId]="merchantId",
          [isAdmin]="true",
          [isAutoTransfer]='isAutoTransfer',
          [autoTransferType]='autoTransferType',
          [autoScheduledAt]='autoScheduledAt',
          (emitAutoTransfer)="toggleAutoTransfer($event)",
          [selectedBank]="selectedBank"
        )
      ng-template(#fd)
        sbpro-fixed-deposit-list([accountId]="accountId")
      ng-template(#authorizer)
        sbpro-authorizer-details(
          [accountId]="accountId",
          [merchantId]="merchantId",
          [readOnly]="readOnly"
        )
      ng-template(#settings)
        sbpro-account-settings([accountId]="accountId", [merchantId]="merchantId")
      ng-template(#statements)
        sbpro-statement-list([accountId]="accountId")
      ng-template(#deposit)
        sbpro-account-deposit([accountId]="accountId")
      ng-template(#logs)
        sbpro-logs([accountId]="accountId")
      ng-template(#fees)
        sbpro-account-fee-details([accountId]="accountId")
      ng-template(#sourceaccount)
        sbpro-account-source-validation(
          [accountId]="accountId",
          [selectedBank]="selectedBank",
          [currentTab]="currentTab",
          (emitNextTab)="nextTab($event)",
          (emitCurrentTab)="setCurrentTab($event)",
          [readOnly]="readOnly"
        )
