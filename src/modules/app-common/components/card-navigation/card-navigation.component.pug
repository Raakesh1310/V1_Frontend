.card.mb-4([ngClass]='cardClasses', [headerActions]='true')
  ng-container(*ngIf='navType !== "vertical"')
    //- class justify added as part of customization in next line
    .card-header.border-bottom([class.justify-content-between]='headerButtons')
      ng-container(*ngIf='navType === "tabbed"')
        ul.nav.nav-tabs.card-header-tabs(role='tablist')
          li.nav-item(*ngFor='let name of navNames; let i = index')
            a.nav-link(
              [ngClass]='{ active: selectedIndex === i, disabled: isDisabled(name) }',
              (click)='setSelectedIndex(i)',
              data-toggle='tab',
              role='tab',
              class='logoColor',
              [attr.aria-selected]='selectedIndex === i'
            ) {{ name }}

      ng-container(*ngIf='navType === "pill"')
        ul.nav.nav-pills.card-header-pills(role='tablist')
          li.nav-item(*ngFor='let name of navNames; let i = index')
            a.nav-link(
              [ngClass]='{ active: selectedIndex === i }',
              (click)='setSelectedIndex(i)',
              data-toggle='tab',
              role='tab',
              [attr.aria-selected]='selectedIndex === i'
            ) {{ name }}

      //- component customization start here
      div(*ngIf='headerButtons.includes(selectedIndex)')
        span.mr-2
          button.btn.btn-icon.btn-xs(
            class='castlerButtonColor',
            *ngIf='!(loadingList$ | async)',
            (click)='onRefresh()'
          )
            i-feather(name='refresh-cw')
        button.btn.btn-icon.btn-xs.mr-2((click)='onToggle()', class='castlerButtonColor')
          i-feather(name='filter')
      //- component customization end here

    .card-body
      .tab-content
        .tab-pane.fade.show.active(
          #fadeableSection,
          role='tabpanel',
          aria-labelledby='overview-tab'
        )
          ng-container(*ngTemplateOutlet='templates[selectedIndexForFade]')

  ng-container(*ngIf='navType === "vertical"')
    ng-content(select='.card-header')

    .card-body
      .row
        .col-md-3
          ul.nav.nav-pills.flex-column(role='tablist')
            li.nav-item(*ngFor='let name of navNames; let i = index')
              a.nav-link(
                [ngClass]='{ active: selectedIndex === i }',
                (click)='setSelectedIndex(i)',
                data-toggle='tab',
                role='tab',
                [attr.aria-selected]='selectedIndex === i'
              ) {{ name }}

        .col-md-9
          .tab-content
            .tab-pane.fade.show.active(
              #fadeableSection,
              role='tabpanel',
              aria-labelledby='overview-tab'
            )
              ng-container(*ngTemplateOutlet='templates[selectedIndexForFade]')

  ng-content(select='.card-footer')
