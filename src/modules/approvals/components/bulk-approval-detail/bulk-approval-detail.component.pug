sbpro-card
  .card-header(class='logoColor') Bulk Transfer Details
  .card-body
    div(*ngIf='errors.length > 0')
      sbpro-alert(classes='alert-danger', [dismissable]='true', (click)='errors = []')
        | {{ errors[0] }}
    form
      .d-flex.mb-2
        input#search-box.mt-1.form-control.w-100.mr-2(
          type='text',
          name='s',
          placement='top',
          autocomplete='off',
          (input) = 'Search($event)',
          [(ngModel)] = 'searchTerm',
          ngbPopover='Search by Business ID, Payment ID, Beneficiary Name',
          placeholder='Search by Business ID, Payment ID, Beneficiary Name',
        )
        input#date-from.mt-1.form-control.w-25.mr-2(
          type='text',
          placeholder='Start Date',
          name='dateFrom',
          ngbDatepicker,
          outsideDays='hidden',
          autocomplete='off',
          #dateFrom='ngbDatepicker',
          (click)='dateFrom.toggle()',
          [(ngModel)] = 'startDate',
          (ngModelChange)="startDateChange()",
          [maxDate]="maxDate"
        )
        input#date-to.mt-1.form-control.w-25.mr-2(
          type='text',
          placeholder='End Date',
          name='dateTo',
          ngbDatepicker,
          outsideDays='hidden',
          autocomplete='off',
          #dateTo='ngbDatepicker',
          (click)='dateTo.toggle()',
          [(ngModel)] = 'endDate',
          (ngModelChange)="endDateChange()",
          [maxDate]='maxDate',
        )
        button.btn.ws-nowrap.mt-1.mb-1(
          class='castlerButtonColor',
          type='submit',
          (click)='filterData()'
        )
          fa-icon.d-flex.flex-row.align-items-center([icon]='["fas", "search"]')
        button.btn.btn-link.mt-1.mb-1.mr-5(
          type='button',
          class='logoColor',
          (click)='clearButtonClick()'
        )
          | Clear

        button.btn.btn-danger(type='button', (click)='openModal(alert)', [disabled]='disableStatusButton',) Reject

    .table-responsive.pp-table-container
      table.table
        thead
          tr
            th(scope='col', sbSortable='event')
              span.ws-nowrap Payment ID
            th(scope='col', sbSortable='time')
              span.ws-nowrap Request Date
            th(scope='col', sbSortable='time')
              span.ws-nowrap From Escrow ID
            th(scope='col', sbSortable='time')
              span.ws-nowrap Benefciary name
            th(scope='col', sbSortable='time')
              span.ws-nowrap Amount
            th(scope='col', sbSortable='time', style='text-align : center')
              input(type='checkbox', [(ngModel)]="isChecked", (change)="selectAll($event)")
        tbody
          tr(*ngIf='isLoading')
            .spinner-border.text-primary(role='status')
              span.sr-only Loading...
          tr(*ngIf='(singleApprovalList.length == 0 && !isLoading)')
            td No Entries Found
          tr(
            *ngFor='let data of singleApprovalList | slice: (transferPage - 1) * transferPageSize:transferPage * transferPageSize'
          )
            td
              ngb-highlight([result]='data.transferId')
            td
              ngb-highlight([result]='data.createdAt.substring(0,10)')
            td
              ngb-highlight([result]='data.accountId')
            td
              ngb-highlight([result]='data.beneficiaryName')
            td
              ngb-highlight([result]='"₹"+data.amount.toFixed(2)')
            td(style='text-align : center')
              input(type='checkbox', [(ngModel)]="isChecked ? isChecked : data.isSelected",
                (change)="checkValue($event,data)", *ngIf='data.status != "Failed"')
    .d-flex.justify-content-between.p-2
      button.btn.btn-light((click)='goBack()') Back
      ngb-pagination(
        [collectionSize]='transferTotal$',
        [maxSize]='5',
        [(page)]='transferPage',
        [pageSize]='transferPageSize',
        [rotate]='true',
        [ellipses]='false',
        (pageChange)='loadPage($event)',
        [boundaryLinks]='true'
      )


ng-template(#alert)
    .flex-display-column(style='background: #FFFBF4')
        div.bold.mt-5 Are you sure you want to
        div.mt-0.bold Reject {{ selectedForOperation }} {{ selectedForOperation == 1 ? "entry" : "entries" }} ?
        input#rejection.form-control.mt-1.w-75.mr-2(
            type='text',
            (input) = 'rejectionReasonChange($event)',
            [(ngModel)] = 'rejectionReason',
            ngbPopover='Rejection Reason',
            placeholder='Enter Rejection Reason',
            required,
            ng-class='rejectionReason == "" ? "ng-invalid" : ""',
        )
        div.flex-display.mb-5.mt-3
            button.btn.btn-light.mr-3(type='button', (click)='closeModal()') No, Go Back
            button.btn.btn-danger(type='button', [disabled]='disableStatusButton',
                (click)='sendSingleBulkApprovals()') {{ disableStatusButton ? "Loading..." : "Reject" }}
