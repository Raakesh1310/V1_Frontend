.form-group
  label(for='label') {{ label }}
  span.linker.float-right(*ngIf='removable && !livePage')
    i-feather(name='trash-2', (click)='rmField()')
  span.text-danger(*ngIf='required') *
  input.form-control.form-control-sm(
    [id]='label',
    type='number',
    [placeholder]='label || ""',
    (change)='onChange()',
    #defInput,
    [value]='value',
    autocomplete='off'
  )
  span.text-danger(*ngIf='errors.length > 0') {{ errors[0] }}
