ng-template(#alert)
    .flex-display-column.rounded(style='background: #FFFAF2;padding-left: 16px;padding-right:16px;border: none')
        div.promotersText.mt-4.mb-3.d-flex.justify-content-center PROMOTER DETAILS
        span.promoterBoxClose((click)="closeAddModal()") &times;
        div.mt-3.flex-display
            label.mr-5(for='name').labelTexts Name
            input#name.form-control(
                style='background: #E2E2E2; border: none; margin-left: 32px',
                type='text',
                [(ngModel)]= 'signatoryName',
                placeholder='Full Name',
                (keydown)='utilityService.onlyAlphaNumeric($event)'
            )
        div.mt-3.mb-3.flex-display(*ngIf='userKycData.businessType === "PartnerShip"')
            label(for='designation', style='margin-right: 20px').labelTexts Designation
            select#designation.form-control(
                    [(ngModel)]='signatoryDes',
                    style='background: #E2E2E2; border: none',
                    (change)='setPages($event.target.value)'
            )
                option Partner
                option Authorised Signatory
        div.mt-3.mb-3.flex-display(*ngIf='userKycData.businessType === "Company"')
            label.mr-5(for='din').labelTexts DIN
            input#din.form-control(
                style='background: #E2E2E2; border: none; margin-left: 53px',
                type='text',
                [(ngModel)]= 'signatoryDin',
                placeholder='Din',
            )
        div.mb-4.flex-display.justify-content-end
            input.continueBtn.rounded(
                type='button',
                (click)='closeModalOfAdd()',
                value='Add',
            )


