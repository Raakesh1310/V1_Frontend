div.rightSideWidthHeight(style='margin: auto;')
    div.flex-display.mt-3.justify-content-between
        p.promotersText.mr-3 PROMOTER DETAILS
        div.flex-display.justify-content-center.orangeBorder.mt-2.rounded((click)='openModal(alert,$event)')
            div.m-1(style='') + Add Signatory
    div(style='font-size: 12px; margin-top: 8px; margin-bottom: 4px;',
        *ngIf='(userKycData.businessType == "Company" && promotersData.length > 0)') *
        | KYC of all directors signing the Board Resolution required
    div.overflow-auto.scrollBoxWidthHeight(style='', id='boxes')
        div.flex-display-column.align-items-center(*ngIf='promotersData.length == 0',
            style='top: 50%;position: relative;-ms-transform: translateY(-50%);transform: translateY(-50%);')
            div.promotersEmptyText No Promoters added yet
            svg(width='88', height='88', viewbox='0 0 88 88', fill='none', xmlns='http://www.w3.org/2000/svg')
                path(d='M25.667 36.6667H62.3337V51.3334H25.667V36.6667Z' fill='black' fill-opacity='0.1')
                path(d='M43.9997 7.33325C23.7817 7.33325 7.33301 23.7819 7.33301 43.9999C7.33301 64.2179 23.7817 80.6666 43.9997 80.6666C64.2177 80.6666 80.6664 64.2179 80.6664 43.9999C80.6664 23.7819 64.2177 7.33325 43.9997 7.33325ZM43.9997 73.3333C27.826 73.3333 14.6663 60.1736 14.6663 43.9999C14.6663 27.8263 27.826 14.6666 43.9997 14.6666C60.1734 14.6666 73.333 27.8263 73.333 43.9999C73.333 60.1736 60.1734 73.3333 43.9997 73.3333Z' fill='black' fill-opacity='0.1')
        div.flex-display-column.justify-content-center.mb-3(*ngFor='let promoter of promotersData, index as i',
            [ngClass]='(promoter.aadharUploaded || promoter.panUploaded) ? "scrollBoxesAfter" : "scrollBoxesBefore"')
            div(style='').scrollBoxesIndex {{ i+1 }}
            div(style='').flex-display.justify-content-between
                div.scrollBoxesNameText {{ promoter.name }}
                div.scrollBoxesDinText.mt-2(*ngIf='userKycData.businessType === "Company"') DIN: {{ promoter.din }}
                div.scrollBoxesDinText.mt-2(*ngIf='userKycData.businessType === "PartnerShip"') {{ promoter.designation }}
            div.flex-display.mt-2
                p.scrollBoxesPanText.mr-3 Email
                .col
                    input#inputBusiness.form-control-sm.mt-1(
                        style='background: #E2E2E2; border: none; width : 100%',
                        [(ngModel)]="promoter.email",
                        (input)='promoterEmailUpdate(promoter.email, promoter)',
                        type='text',
                        placeholder='Enter Email',
                        (change)='addErrors($event.target.value)'
                    )
                    span(*ngIf='emailErrorsList[promoter.email]')
                        span.text-danger {{ emailErrorsList[promoter.email] }}
            .container-fluid.no-padding
                .row
                    .col-md
                        p.scrollBoxesPanText.mr-2 PAN
                        div(style='width: 100%')
                            ng-template(#uploadPanImage)
                                sbpro-document-upload-modal((uploadData)='uploadPanData($event,promoter)',
                                    (dismissModal)= 'dismissPanModal(promoter)', [imgSrc] = 'imgSrc',
                                    (closeModal)='closePanModal($event,promoter)', [documentType] = '"Pan"', [isLoading]='isLoading')
                            .chip.mt-1.whiteBackground.myanchor(#parentElement, *ngIf='!promoter.panUploaded',
                                (click)='openModal(uploadPanImage,$event)')
                                p(style='font-size: 10px; color: rgba(62, 40, 8, 0.65)') Upload
