                span.text-danger *
            p.subLabelDetails(style='margin-top: -8px') pdf/jpg/png under 2MB.
        div.flex-display.mt-2(style='max-width: 300px; width: 100%;')
            div.input-group.rounded
                input.form-control-sm.myanchor.inputBoxStyle(
                    style='width: 80%;',
                    type='text',
                    readonly,
                    placeholder='Browse',
                    [(ngModel)]='gstImageName',
                    (click)='selectGst()',
