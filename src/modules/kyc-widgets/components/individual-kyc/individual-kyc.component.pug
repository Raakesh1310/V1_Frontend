div.rightSideWidthHeight(*ngIf='!panVerified')
    div.mt-3.kycDetailsText(style="") KYC DETAILS
    div(style='border-top: 5px solid rgba(0, 0, 0, 0.19);width: 220px')
    div.mt-3
        .row
            .col-md
                div.completeAadhaarKycText Verify Your Photo First
                input.continueBtn.rounded.mt-4(
                    type='button',
                    (click)='openModal(selfie,$event)',
                    [value]='userSelfie != "" ? "Re-take" : "Capture"',
                )
            .col-md(style='display: flex; justify-content: center')
                img([src]= 'userSelfie != "" ? userSelfie : "/assets/img/users-icon.png"',
                    width='130', height='120')
    div.mt-5
        .row
            .col-md
                div.completeAadhaarKycText Complete Your Digital KYC
                div.mt-3 Share your aadhaar & pan details for verification.
            .col-md
                img(src='/assets/img/aadhaarImage.jpg', width='200', height='120')

        input.continueBtn.rounded.mt-2(
            type='button',
            (click)='startDigilocker()',
            value='Start',
        )
    div.mr-3.mb-3.bottomRight.myanchor((click)='moveFront()')
        svg([ngClass]='allDocsVerified ? "arrowOrange" : "arrowBlack"', width='75', height='75', viewbox='0 0 70 70', fill='none', xmlns='http://www.w3.org/2000/svg')
            path(d='M37.8195 19.8857L34.4416 23.1763L47.6226 36.4212H18.9219V41.1456H47.6226L34.4416 54.3101L37.8195 57.681L56.7171 38.7834L37.8195 19.8857Z')
