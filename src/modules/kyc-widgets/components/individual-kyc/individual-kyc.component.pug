ng-template(#selfie)
    sbpro-selfie-kyc((dismissModal)= 'dismissModal()', [crnId]= 'crnId', (captureImg) = 'captureImage($event)')

ng-template(#pan)
    sbpro-document-upload-modal((uploadData)='uploadData($event,selectedDoc.pan)', (dismissModal)= 'dismissModal()',
            [imgSrc] = 'imgSrc', (closeModal)='closeModal($event, selectedDoc.pan)', [documentType] = '"Pan"',
            [isLoading] = 'isLoading')

ng-template(#aadharFront)
    sbpro-document-upload-modal((uploadData)='uploadData($event,selectedDoc.aadharFront)', (dismissModal)= 'dismissModal()',
            [imgSrc] = 'imgSrc', (closeModal)='closeModal($event, selectedDoc.aadharFront)',
            [documentType] = '"Aadhar Front"')

ng-template(#aadharBack)
    sbpro-document-upload-modal((uploadData)='uploadData($event,selectedDoc.aadharBack)', (dismissModal)= 'dismissModal()',
            [imgSrc] = 'imgSrc', (closeModal)='closeModal(selectedDoc.aadharBack)')

ng-template(#warningMessage)
  .card-header.modal-header.logoColor Warning Message
  .card-body
    p Please allow location tracking to proceed further.
  .card-footer
    button.btn.btn-sm.float-right.castlerButtonColor((click)='closeModal(true)') Close