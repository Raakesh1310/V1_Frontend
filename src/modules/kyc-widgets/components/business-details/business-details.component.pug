    div.mt-4.d-flex.justify-content-between(style='flex-wrap: wrap;')
        label(for='inputBusiness').labelText.mt-1 Business Name    
        input#inputBusiness.form-control-sm(
            style='background: #E2E2E2; max-width: 290px; width: 100%; border: none'
            type='text',
            [(ngModel)]='businessName',
            (input)= 'inputValueChange($event.target.value, "Business Name")',
            placeholder='Enter Business',
        )
    small
        small
            small Business name as per GST
    div.mt-3.d-flex.justify-content-between(style='flex-wrap: wrap;')
        label(for='inputIndustry').labelText.mt-1 Industry Type
        select#inputIndustry.form-control.form-control-sm(
            style='background: #E2E2E2; max-width: 290px; width: 100%; border: none',
            [(ngModel)]='industryType',
            (change)='setPages($event.target.value)'
        )
            option Financial Services
            option E-commerce/Marketplace
            option IT/ITES
            option Real Estate
            option VC/PE
            option Others
    div.custom-control.custom-switch.mt-3
        input#customSwitches.custom-control-input(type='checkbox', style='background: orange',
            [(ngModel)]='importExport', (change)='importChange($event)')
        label.custom-control-label(for='customSwitches').labelText.mt-1 Is the entity involved in import/export?
    div.mt-3.d-flex.justify-content-between(style='flex-wrap: wrap;')
        label(for='inputAnnual').labelText.mt-1 Annual Revenue (₹)
