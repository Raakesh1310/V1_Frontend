sbpro-card([headerActions]='true')
  .card-header.logoColor
    | Escrow pages
    div
      span.mr-2
        .spinner-border.spinner-border-sm.text-primary.mr-1(
          role='status',
          aria-hidden='true',
          *ngIf='loadingList$ | async'
        )
        button.btn.btn-icon.btn-xs.castlerButtonColor(
          *ngIf='!(loadingList$ | async)',
          (click)='refreshData()'
        )
          i-feather(name='refresh-cw')
      button.btn.btn-icon.btn-xs.castlerButtonColor(
        (click)='toggleFilters()'
      )
        i-feather(name='filter')
  .card-body.flex-container.align-self-stretch
    div
      form.pb-2(*ngIf='filtersVisible')
        .d-flex.mb-2
          input#search-box.mt-1.form-control.w-100.mr-2(
            placement='top',
            [ngbPopover]='isSuperAdmin ? "Search by Business Name, Template name, Virtual ID" : "Search by Template Name, Escrow Page ID"',
            type='text',
            autocomplete='off',
            name='s',
            [placeholder]='isSuperAdmin ? "Search by Business Name, Template name, Virtual ID" : "Search by Template Name, Escrow Page ID"',
            [(ngModel)]='escrowPageService.searchTerm'
          )
          input#start-date.mt-1.form-control.w-25.mr-2(
            type='text',
            name='sd',
            placeholder='Start Date',
            autocomplete='off',
            ngbDatepicker,
            outsideDays='hidden',
            #sd='ngbDatepicker',
            (click)='sd.toggle()',
            [(ngModel)]='escrowPageService.dateFrom',
            [minDate]='escrowPageService.dateFromMin',
            [maxDate]='escrowPageService.dateFromMax'
          )
          input#end-date.mt-1.form-control.w-25.mr-2(
            type='text',
            name='ed',
            placeholder='End Date',
            autocomplete='off',
            ngbDatepicker,
            outsideDays='hidden',
            #ed='ngbDatepicker',
            (click)='ed.toggle()',
            [(ngModel)]='escrowPageService.dateTo',
            [minDate]='escrowPageService.dateToMin',
            [maxDate]='escrowPageService.dateToMax'
          )
          button.btn.mr-2.ws-nowrap.mt-1.castlerButtonColor(
            type='submit',
            (click)='loadData()'
          )
            fa-icon.d-flex.flex-row.align-items-center(
              [icon]='["fas", "search"]'
            )
          button.btn.btn-link.mr-2.logoColor(
            type='button',
            (click)='clearSearchForm()'
          ) Clear
        .d-flex(*ngIf='(ePages$ | async)?.length > 0')
          .flex-row
            small.mb-2.mt-2 Showing {{ (escrowPageService.page - 1) * 10 + 1 }} to {{ (escrowPageService.page - 1) * 10 + (ePages$ | async)?.length }} of {{ total$ | async }}
    .table-responsive.pp-table-container.align-self-stretch.flex-grow-1.flex-stretch-1.table-striped
      table.table
        thead
          tr
            th.th-sticky-top(
              scope='col',
              sbSortable='date',
              (sort)='onSort($event)',
              *ngIf='isSuperAdmin'
            )
              span.ws-nowrap Business Name
              sb-sort-icon(
                *ngIf='sortedColumn === "date"',
                [direction]='sortedDirection'
              )
            th.th-sticky-top(scope='col', sbSortable='time', (sort)='onSort($event)')
              span.ws-nowrap Escrow Page ID 
              sb-sort-icon(
                *ngIf='sortedColumn === "time"',
                [direction]='sortedDirection'
              )
            th.th-sticky-top(scope='col', sbSortable='date', (sort)='onSort($event)')
              span.ws-nowrap Template Name
              sb-sort-icon(
                *ngIf='sortedColumn === "date"',
                [direction]='sortedDirection'
              )
            th.th-sticky-top(
              scope='col',
              sbSortable='event',
              (sort)='onSort($event)'
            )
              span.ws-nowrap Creation Date
              sb-sort-icon(
                *ngIf='sortedColumn === "date"',
                [direction]='sortedDirection'
              )
            //- th.th-sticky-top(
            //-   scope='col',
            //-   sbSortable='event',
            //-   (sort)='onSort($event)'
            //- )
            //-   span.ws-nowrap Escrow ID
            //-   sb-sort-icon(
            //-     *ngIf='sortedColumn === "event"',
            //-     [direction]='sortedDirection'
            //-   )
            th.th-sticky-top(scope='col', sbSortable='time', (sort)='onSort($event)')
              span.ws-nowrap URL
              sb-sort-icon(
                *ngIf='sortedColumn === "time"',
                [direction]='sortedDirection'
              )
            th.th-sticky-top(scope='col', sbSortable='time', (sort)='onSort($event)')
              span.ws-nowrap Action
              sb-sort-icon(
                *ngIf='sortedColumn === "time"',
                [direction]='sortedDirection'
              )

        tbody(*ngIf='(ePages$ | async)?.length > 0 && !(loadingList$ | async)')
          tr(
            *ngFor='let epage of ePages$ | async',
            (mouseover)='selectedToolTipData = epage'
          )
            td(*ngIf='isSuperAdmin')
              a.nav-link.p-0.tableClickEntryColor(
                href='javascript:void(0);',
                (click)='openMerchantDetails(epage.merchant.merchantId)'
              )
                ngb-highlight([result]='epage.businessName || "--"')
            td
              ngb-highlight([result]='epage.escrowPageId || "--"')

            td
              a.nav-link.p-0.tableClickEntryColor(
                href='javascript:void(0);',
                (click)='viewDetails(epage.escrowPageId)'
              )
                ngb-highlight([result]='epage.title || "--"')

            td
              ngb-highlight(
                [result]='epage.createdAt | date: "d MMM yyyy" || "--"'
              )

            //- td
            //-   span.tableClickEntryColor(
            //-     *ngIf='epage.accounts',
            //-     style='cursor: pointer; white-space: pre-line',
            //-     [ngbPopover]='ToolTip',
            //-     triggers='mouseenter:mouseleave'
            //-   ) 
            //-   span(*ngIf='!epage.accounts') --

            td
              ngb-highlight([result]='epage.url || "--"')

            td
              button.btn-sm.btn.btn-light(
                [cdkCopyToClipboard]='epage.url',
                (click)='doneCopy()'
              ) copy link

    .flex-container.flex-row(
      *ngIf='(ePages$ | async)?.length <= 0 && !(loadingList$ | async)'
    )
      .align-self-center No Data available
    .flex-container.flex-row(*ngIf='loadingList$ | async')
      .align-self-center Please wait...
    .d-flex.justify-content-between.pt-2.align-self-end(
      *ngIf='(ePages$ | async)?.length > 0 && !(loadingList$ | async)'
    )
      ngb-pagination(
        [collectionSize]='total$ | async',
        [(page)]='escrowPageService.page',
        [maxSize]='5',
        [rotate]='true',
        [ellipses]='false',
        [boundaryLinks]='true'
      )

ng-template(#ToolTip)
  .leftAlign Escrows -
  ul.leftAlign(*ngFor='let data of selectedToolTipData.accounts')
    li {{ data.id }}
