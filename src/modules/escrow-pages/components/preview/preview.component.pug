sbpro-card(*ngIf='innerWidth > 600', [headerActions]='true')
	.card-header(*ngIf='isModal')
		| Preview Page
		button.btn.btn-icon.btn-link.btn-xl.castlerButtonColor1((click)='closer()')
			i-feather(name='x-circle')
	.card-body.main.p-0.m-0(style='height:100%')
		//- .row.header-row
		//-   .col-lg-4.col-md-4.col-sm-12
		//-     img.logo([src]='escrowPage.logo' alt='Business Logo' height='50vh') 
		//-   .col-lg-8.col-md-8.col-sm-12.bussiness-name
		//-     span {{ escrowPage.businessName }}
		.container.m-0.p-0(style='height:100%; max-width:100%;')
			.row.m-0.p-0(style='height:100%; width:100%;') 
				.col-sm(style='height:100%; padding: 0% 5%; overflow:auto;')
					.header-row(style='padding-top: 5%')
						.col-lg-4.col-md-4.col-sm-12
							img.logo(
								src='https://myescrow.castler.com/assets/img/Castler_logo.png',
								alt='Castler Logo',
								height='50vh'
							)
					.opacity.no-scroll(style='padding-top: 10%')
						.card-body
							.form-group.title {{ escrowPage.title }}
								.mt-2(style='height:8px; width:100px; background:#FF9900')
							form
								.form-group(*ngFor='let field of productFields')
									label.label.p-0(style='font-size:25px') {{ field.label }}
									div(
										*ngIf='!field.label.includes("Amount")',
										style='font-size:25px;'
									) {{ field.value }}
									div(
										*ngIf='field.label.includes("Amount")',
										style='font-size:25px;'
									) ₹ {{ field.value }}
				.col-sm(
					*ngIf='!paymentSuccessful && !paymentFailed && !paymentPending && !loading',
					style='background:#02042B; height:100%; padding: 0% 5%; overflow:auto;'
				)
					.header-row(style='padding-top: 7%; color:white;')
						.col-lg-8
							img.logo(src='/assets/img/person-icon-png-transparent.png' alt='Business Logo' height='50vh')
							span.bussiness-name.float-right(
								style='color:white;position:absolute; right:-140px'
							)
								h3.text-white {{ escrowPage.businessName }}
						//- .col-lg-8.col-md-8.col-sm-12.bussiness-name.float-right
						//-   span(style='color:white;')
							h3.text-white {{ escrowPage.businessName }}
					.col-sm(style='padding-top: 5%; padding-bottom: 5%;')
						div(style='border-radius: 25px; background: #222346; color: white; ')
							h2.pl-4.pt-5(style='color:white;') PAYMENT DETAILS
							form.pt-2.pl-5([formGroup]='paymentDetailsForm' action='') 
								.row
									.form-group(style='width:90%')
										label(for='account') Select Escrow Name
										span.text-danger *
										br
										ng-select(
											[items]='accounts',
											bindLabel='name',
											[(ngModel)]='selectedAccount',
											[ngModelOptions]='{ standalone: true }',
											loadingText='Loading...',
											placeholder='Enter Escrow Name',
											(change)='updateAccount()',
											(search)='searchAccount($event.term)',
											name='account'
										)
											ng-template(ng-label-tmp='' let-item='item')
												//- span(*ngIf='selectedAccount') {{ item.bank.accountNumber }}
												span(*ngIf='selectedAccount') {{ item.itemName }}
											ng-template(
												ng-option-tmp='',
												let-item='item',
												let-search='searchTerm',
												let-index='index'
											)
												//- span.sup-option {{ item.bank.accountNumber }}
												span.sup-option {{ item.itemName }}
										span(*ngIf='accountError')
											span.text-danger {{ accountError }}
								.row
									.form-group(style='width:90%')
										label(for='amount') Amount
										span.text-danger *
										br
										input#amount(
											type='number',
											[(ngModel)]='amount',
											placeholder='Enter amount',
											formControlName='amount',
											autocomplete='off',
											style='width:100%; border-radius:4px',
											(change)='setButtonText()',
											name='amount'
										)
										span(*ngIf='amountError')
											span.text-danger {{ amountError }}
								.row
									.form-group(style='width:90%')
										label(for='name') Name
										span.text-danger *
										br
										input#name(
											type='name',
											placeholder='Enter name',
											formControlName='name',
											autocomplete='off',
											style='width:100%',
          									(keydown)='utilityService.onlyAlphaNumeric($event)'
										)
										span(*ngIf='nameError')
											span.text-danger {{ nameError }}
								.row
									.form-group(style='width:90%')
										label(for='email') Email
										span.text-danger *
										br
										input#email(
											type='email',
											placeholder='Email',
											formControlName='email',
											autocomplete='off',
											style='width:100%',
											(change)='validateEmail()'
										)
										span(*ngIf='emailError')
											span.text-danger {{ emailError }}
								.row
									.form-group(style='width:90%')
										label(for='mobile') Mobile Number
										span.text-danger *
										br
										input#mobile(
											type='number',
											placeholder='Enter mobile number',
											formControlName='mobile',
											autocomplete='off',
											style='width:100%',
											(change)='validateMobile()',
          									(keydown)='validateKeyDownMobile($event)'
										) 
										span(*ngIf='mobileError')
											span.text-danger {{ mobileError }}
								.row(
									*ngFor='let field of customerFields.fields.slice(4); index as i'
								)
									.form-group(style='width:90%')
										label.label {{ field.label }}
										span(*ngIf='field.required').text-danger *
										br
										input(
											type='{{ field.type }}',
											placeholder='{{ field.label }}',
											autocomplete='off',
											style='width:100%',
											(change)='addValue($event)',
          									(keydown)='utilityService.onlyAlphaNumeric($event)'
										) 
										span(*ngIf='field.type === "pan" && panError')
											span.text-danger {{ panError }}
										span(*ngIf='field.type === "aadhaar" && aadhaarError')
											span.text-danger {{ aadhaarError }}
										span(*ngIf='field.type === "custom" && customError')
											span.text-danger {{ customError }}
								.row
									.pr-5.mr-2(style='width:100%')
										.form-group.float-right
											sbpro-app-button(
												*ngIf='amount',
												(click)='submit()',
												text='Pay ₹ {{amount}}',
												loadingText='Loading...',
												[disabled]='updating',
												[loading]='updating',
												[btnClass]='{ "btn-block": false, "btn-primary": true, "btn-md": true }'
											) Pay ₹ {{ amount }}
											sbpro-app-button(
												*ngIf='!amount',
												(click)='submit()',
												text='Pay ₹ {{amount}}',
												[disabled]='updating',
												loadingText='Loading...',
												[loading]='updating',
												[btnClass]='{ "btn-block": false, "btn-primary": true, "btn-md": true }'
											) Pay ₹ 0.00
				.col-sm(
					*ngIf='paymentSuccessful || paymentFailed || paymentPending',
					style='background:#02042B; height:100%; padding: 0% 5% 10% 5%;'
				)
					.header-row(style='padding-top: 5%; color:white;')
						.col-lg-8
							img.logo(src='/assets/img/person-icon-png-transparent.png' alt='Business Logo' height='50vh')
							span.bussiness-name.float-right(
								style='color:white;position:absolute; right:-140px'
							)
								h3.text-white {{ escrowPage.businessName }}
					.col-sm(style='padding-top: 10%;')
						div(
							style='border-radius: 25px; background: #222346; color: white; height: 100%; width: 100%'
						)
							div(style='padding:5%; text-align:center;')
								div(style='color:white; font-size:20px; font-weight:700px;')
									img(
										*ngIf='paymentSuccessful',
										src='/assets/img/success.gif',
										alt='success',
										width='100',
										height='100',
										style='border-radius:50%; margin-bottom:5%'
									)
									img(
										*ngIf='paymentFailed',
										src='/assets/img/failed.gif',
										alt='success',
										width='100',
										height='100',
										style='border-radius:50%; margin-bottom:5%'
									)
									img(
										*ngIf='!paymentSuccessful && !paymentFailed && paymentPending',
										src='/assets/img/pending.gif',
										alt='success',
										width='100',
										height='100',
										style='border-radius:50%; margin-bottom:5%'
									)
									h1(*ngIf='paymentSuccessful || paymentFailed || !paymentPending' style='color:white; font-size:50px; font-weight:900px;') ₹ {{ amount }}
									h1(
										*ngIf='paymentSuccessful',
										style='color:white; font-size:40px; font-weight:800px;'
									) Payment Successful
									h1(
										*ngIf='paymentFailed',
										style='color:white; font-size:40px; font-weight:800px;'
									) Payment Failed
									h1(
										*ngIf='!paymentSuccessful && !paymentFailed && paymentPending',
										style='color:white; font-size:40px; font-weight:800px;'
									) Pending
									br
									p(*ngIf='paymentSuccessful') Your payment Id: {{ paymentId }}
									p(*ngIf='paymentFailed') Your order Id: {{ orderId }}
									p(*ngIf='!paymentSuccessful && !paymentFailed && paymentPending') Your order Id: {{ orderId }}
									//- p A confirmation email has been sent to you.
			.card-footer(*ngIf='isModal')
				button.modalBtn.btn.float-right.castlerButtonColor((click)='genLink()') Generate Link
				button.modalBtn.btn.btn-link.float-right.castlerButtonColor1(
					(click)='closer()'
				) Edit
